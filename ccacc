#!/bin/bash
# ccacc – Claude Code official account switcher for macOS
# Claude login and account history follow the account: only claudeAiOauth from the
# "Claude Code-credentials" keychain item, the account-bound keys of
# ~/.claude.json, the history/state folders under ~/.claude and the Claude CLI cache.
# Keychain items with a suffix (other CLAUDE_CONFIG_DIRs, Orca accounts), the shared Cowork
# device keys and the Claude desktop app are never touched. MCP OAuth and other
# unrelated credential fields remain shared and are never restored from account backups.
# Login backups are plain JSON files (<name>.credentials, mode 600) without encryption.
# Older encrypted backups (<name>.credentials.enc) are migrated once with their master password.
# Install with install.sh, which keeps ccacc beside its sourced companion ccacc_shell.sh

set -e

SCRIPT_NAME="ccacc"
VERSION="0.1.0"
INSTALL_COMMAND="curl -fsSL https://raw.githubusercontent.com/geminiwen/ccacc/main/install.sh | bash"

# Always the default config dir, whatever CLAUDE_CONFIG_DIR says
CONFIG_DIR="$HOME/.claude"
CLAUDE_JSON="$HOME/.claude.json"
# Claude Code on macOS can fall back to this plaintext file when the keychain is unavailable.
# ccacc never stores logins there; 'new' only scrubs a stray claudeAiOauth from it.
STRAY_CREDENTIALS_FILE="$CONFIG_DIR/.credentials.json"
KEYCHAIN_SERVICE="Claude Code-credentials"
DEVICE_KEY_SERVICE="Claude Code-device-keys"
DEVICE_KEY_FILE="$CONFIG_DIR/.device-keys.json"
ACCOUNTS_DIR="$CONFIG_DIR/accounts"
# Hidden names cannot pass check_name, keeping metadata separate from account stashes.
ALIASES_DIR="$ACCOUNTS_DIR/.aliases"
TIMEZONES_DIR="$ACCOUNTS_DIR/.timezones"
LEGACY_PENDING_TIMEZONE_FILE="$ACCOUNTS_DIR/.pending-timezone"
UNNAMED_SESSION_FILE="$ACCOUNTS_DIR/.unnamed-session"
ACTIVE_FILE="$ACCOUNTS_DIR/.active"
LAUNCH_MODE_FILE="$ACCOUNTS_DIR/.launch-mode"
CLEANUP_RECOVERY_DIR="$ACCOUNTS_DIR/.cleanup-recovery"
# Left over from encrypted backups; only read and removed by migrate_encrypted_backups.
LEGACY_CHECK_FILE="$ACCOUNTS_DIR/.check.enc"
# Optional user settings; ccacc only reads this file. The installer may create it.
SETTINGS_FILE="$HOME/.ccacc/settings.json"
SURGE_CLI=""
SURGE_APP="/Applications/Surge.app"

# Account-bound keys of ~/.claude.json: everything cccleaner clears or resets (identity IDs,
# account caches, per-install counters and usage, project history, repo paths, bridge records).
# Everything else (mcpServers, settings, ...) stays shared between accounts
ACCOUNT_KEYS='[
    "userID", "userId", "anonymousId", "machineID",
    "oauthAccount", "chromeExtension", "hasShownOpus45Notice", "hasCompletedOnboarding",
    "cachedChangelog", "cachedStatsigGates", "cachedDynamicConfigs", "cachedGrowthBookFeatures",
    "cachedGrowthBookFeaturesAt", "metricsStatusCache", "clientDataCache", "clientDataCacheSlots",
    "cachedArtifactRoster", "cachedUsageUtilization",
    "additionalModelCostsCache", "additionalModelOptionsAnsweredAt", "announcementImpressions",
    "apiCreditLinkStatusCache", "autoCompactWindowsCache",
    "bridgeOauthDeadExpiresAt", "bridgeOauthDeadFailCount", "cachedChromeExtensionInstalled",
    "cachedExperimentData", "cachedExperimentFeatures", "cachedExtraUsageDisabledReason",
    "claudeAiMcpEverConnected", "githubWebConnectionStatusCache", "groveChoiceSeenAt",
    "hasAvailableSubscription", "hasRemoteEnvironment", "mcpNeedsAuthNoticed",
    "modelAccessCache", "orgModelDefaultCache", "penguinModeOrgEnabled",
    "promoStartupSeenCount", "promoStartupStatusCache", "rcLongTurnNudgeSeenCount",
    "rcLongTurnNudgeSeenKey", "seenNotifications", "tipsHistoryByCommand",
    "additionalModelOptionsCache", "overageCreditGrantCache", "groveConfigCache",
    "passesEligibilityCache", "s1mAccessCache", "changelogLastFetched", "lastPlanModeUse",
    "passesUpsellSeenCount", "passesLastSeenRemaining",
    "numStartups", "btwUseCount", "promptQueueUseCount", "opus1mMergeNoticeSeenCount",
    "voiceNoticeSeenCount", "slackAppInstallCount", "autoPermissionsNotificationCount",
    "remoteControlUpsellSeenCount", "closedIssuesLastChecked", "ideHintShownCount",
    "opusProMigrationTimestamp", "claudeCodeFirstTokenDate", "routineFiredWatermark",
    "skillUsage", "toolUsage", "pluginUsage", "agentLastUsed", "feedbackSurveyState",
    "tipsHistory", "tipLifetimeShownCounts",
    "firstStartTime", "lastShownEmergencyTip", "companion", "lastOnboardingVersion", "lastReleaseNotesSeen",
    "projects", "githubRepoPaths", "replBridgePlaceholders"
]'

# Files and folders cccleaner wipes; they are moved in and out with the account (<backup name>|<path>)
# ~/.claude/cache is deliberately absent: its changelog, model catalog and closed-issue list
# are account-neutral and rebuild themselves, so they stay shared and are never archived.
ACCOUNT_PATHS=(
    "backups|$CONFIG_DIR/backups"
    "debug|$CONFIG_DIR/debug"
    "file-history|$CONFIG_DIR/file-history"
    "feedback-drafts|$CONFIG_DIR/feedback/drafts"
    "paste-cache|$CONFIG_DIR/paste-cache"
    "plans|$CONFIG_DIR/plans"
    "projects|$CONFIG_DIR/projects"
    "sessions|$CONFIG_DIR/sessions"
    "session-env|$CONFIG_DIR/session-env"
    "shell-snapshots|$CONFIG_DIR/shell-snapshots"
    "stats-cache.json|$CONFIG_DIR/stats-cache.json"
    "statsig|$CONFIG_DIR/statsig"
    "tasks|$CONFIG_DIR/tasks"
    "telemetry|$CONFIG_DIR/telemetry"
    "todos|$CONFIG_DIR/todos"
    "history.jsonl|$CONFIG_DIR/history.jsonl"
    "gh-pr-status-cache.json|$CONFIG_DIR/gh-pr-status-cache.json"
    "cli-nodejs-cache|$HOME/Library/Caches/claude-cli-nodejs"
)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[1;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to show usage
usage() {
    # usage is listed only when ccusage is installed.
    local usage_line='' surge_line='' BLUE=$'\033[0;34m' NC=$'\033[0m'
    # surge is listed only when Surge is installed (it need not be running).
    if command -v surge-cli >/dev/null 2>&1 || [ -d "$SURGE_APP" ]; then
        surge_line=$'\n  surge <name>          Pick the Surge policies an account uses (use applies them)'
    fi
    if command -v ccusage >/dev/null 2>&1; then
        usage_line=$'\n  usage [ccusage args]  Run ccusage over the current and every saved account\'s history'
    fi
    cat << EOF
${BLUE}ccacc – Claude Code Account Switcher v${VERSION}${NC}

Usage: $SCRIPT_NAME [COMMAND] [OPTIONS]

Commands:
  list, ls              List saved accounts
  current               Show the current Claude account
  save <name>           Save the current account
  use [name]            Switch to a saved account
  new                   Log out to a clean session
  rm <name>             Delete a saved account${surge_line}
  timezone [name]       Print the session's or an account's timezone${usage_line}
  help                  Show this help message
  -v, --version         Show version information

Settings: ~/.ccacc/settings.json, e.g. {"alwaysYOLO": true} skips the YOLO question.

EOF
}

# Function to show version
version() {
    echo "${SCRIPT_NAME} v${VERSION}"
}

# Function to check that jq and Claude Code's config are available
check_ready() {
    if ! command -v jq &> /dev/null; then
        echo -e "${RED}Error: jq is required${NC}"
        return 1
    fi

    if [ ! -f "$CLAUDE_JSON" ]; then
        echo -e "${RED}Error: $CLAUDE_JSON not found, run Claude Code at least once${NC}"
        return 1
    fi

    if [ -n "$CLAUDE_CONFIG_DIR" ]; then
        echo -e "${YELLOW}Note: CLAUDE_CONFIG_DIR is ignored; ccacc only switches the default account in ~/.claude${NC}"
    fi

    mkdir -p -m 700 "$ACCOUNTS_DIR"
}

# Function to validate an account name (it becomes a file and folder name)
check_name() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: Account name required${NC}"
        usage
        return 1
    fi

    if [[ ! "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo -e "${RED}Error: Account name must start with a letter or digit and only contain letters, digits, '.', '_' and '-'${NC}"
        return 1
    fi
}

valid_timezone() {
    [[ "$1" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]] \
        && [ -f "/usr/share/zoneinfo/$1" ]
}

# Intentionally independent of check_ready, passwords, credentials and shell
# startup. stdout is a machine-readable API: one validated zone or nothing.
read_timezone_file() {
    local zone
    # Exactly one saved zone, optionally followed by one newline.
    zone=$(jq -Rser 'select(test("^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*\\n?\\z"))
        | rtrimstr("\n")' "$1" 2>/dev/null) || return 1
    valid_timezone "$zone" || return 1
    printf '%s\n' "$zone"
}

# A new, structured record is the only trusted unnamed-session selection. Never
# read legacy .pending-timezone or infer TZ from the caller. Keep this getter
# independent of the installed companion and reject links at every component.
unnamed_session_timezone() {
    local path="$UNNAMED_SESSION_FILE" zone
    case "$path" in /*) ;; *) return 1 ;; esac
    case "$path/" in *'/../'*|*'/./'*|*'//'*) return 1 ;; esac
    while [ -n "$path" ]; do
        [ ! -L "$path" ] || return 1
        if [ "$path" != "$UNNAMED_SESSION_FILE" ]; then
            [ ! -e "$path" ] || [ -d "$path" ] || return 1
        fi
        path=${path%/*}
    done
    [ -e "$UNNAMED_SESSION_FILE" ] || return 3
    [ -f "$UNNAMED_SESSION_FILE" ] && [ -r "$UNNAMED_SESSION_FILE" ] || return 1
    zone=$(jq -ser 'select(length == 1) | .[0] | select(type == "object")
        | select(keys == ["timezone", "version"] and .version == 1)
        | .timezone | select(type == "string")
        | select(test("^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*\\z"))' "$UNNAMED_SESSION_FILE" 2>/dev/null) || return 1
    valid_timezone "$zone" || return 1
    printf '%s\n' "$zone"
}

validate_unnamed_session() {
    local status=0
    unnamed_session_timezone >/dev/null || status=$?
    case "$status" in 0|3) return 0 ;; esac
    echo "Error: Unsafe or malformed unnamed session metadata; account unchanged" >&2
    return 1
}

timezone_command() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        [ ! -e "$CLEANUP_RECOVERY_DIR" ] && [ ! -L "$CLEANUP_RECOVERY_DIR" ] || return 1
        if profile_recovery_path >/dev/null; then return 1; fi
        # Exit 3 means a legitimate unnamed session, never corrupt metadata.
        # The generated hook uses it to unset TZ without prompting or writing.
        if [ ! -e "$ACTIVE_FILE" ] && [ ! -L "$ACTIVE_FILE" ]; then
            unnamed_session_timezone
            return $?
        fi
        [ -f "$ACTIVE_FILE" ] && [ ! -L "$ACTIVE_FILE" ] || return 1
        name=$(jq -Rser 'select(test("^[A-Za-z0-9][A-Za-z0-9._-]*\\n?\\z")) | rtrimstr("\n")' "$ACTIVE_FILE" 2>/dev/null) || return 1
        [ -f "$ACCOUNTS_DIR/$name.json" ] && [ ! -L "$ACCOUNTS_DIR/$name.json" ] || return 1
        jq -se 'length == 1 and (.[0] | type) == "object"' "$ACCOUNTS_DIR/$name.json" >/dev/null 2>&1 || return 1
    fi
    check_name "$name" >/dev/null 2>&1 || return 1
    read_timezone_file "$TIMEZONES_DIR/$name"
}

# Internal read-only API for the fixed hook. Invalid, absent, stale or unsafe
# session metadata always means normal permissions; no startup/credential work.
launch_mode_command() {
    local active path="$LAUNCH_MODE_FILE"
    case "${HOME:-}" in /*) ;; *) printf 'false\n'; return 0 ;; esac
    while [ -n "$path" ]; do
        if [ -L "$path" ]; then printf 'false\n'; return 0; fi
        path=${path%/*}
    done
    if [ ! -f "$ACTIVE_FILE" ] || ! timezone_command >/dev/null 2>&1 || [ ! -f "$LAUNCH_MODE_FILE" ]; then
        printf 'false\n'; return 0
    fi
    active=$(jq -Rser 'select(test("^[A-Za-z0-9][A-Za-z0-9._-]*\\n?\\z"))
        | rtrimstr("\n")' "$ACTIVE_FILE" 2>/dev/null) || { printf 'false\n'; return 0; }
    if jq -se --arg account "$active" 'length == 1 and (.[0] |
        keys == ["account", "version", "yolo"] and .version == 1 and
        .account == $account and (.yolo | type == "boolean") and .yolo == true)' \
        "$LAUNCH_MODE_FILE" >/dev/null 2>&1; then printf 'true\n'
    else printf 'false\n'; fi
}

# An explicit first-setup choice only; never infer a zone from the environment,
# host settings, account name or alias. stdout contains only the validated zone.
choose_timezone() {
    local name="$1" optional="${2:-}" choice zone index
    local zones=(UTC Asia/Shanghai Asia/Tokyo Australia/Sydney Europe/London America/New_York America/Los_Angeles)
    if [ "$optional" = optional ]; then
        printf "Timezone setup for '%s' (optional; blank/EOF = default, TZ unset):\n" "$name" >&2
    else
        printf "Timezone setup for '%s' (required, no default):\n" "$name" >&2
    fi
    for ((index = 0; index < ${#zones[@]}; index++)); do
        printf '  %s) %s\n' "$((index + 1))" "${zones[$index]}" >&2
    done
    printf '  8) Custom IANA timezone\n' >&2
    if [ "$optional" = optional ]; then printf '  q) Cancel cleanup\n' >&2; fi
    printf 'Choose timezone (1-8): ' >&2
    if ! IFS= read -r choice; then
        [ "$optional" != optional ] || return 0
        echo "Error: Timezone required; use --timezone <ZONE>" >&2
        return 1
    fi
    case "$choice" in
        '') [ "$optional" != optional ] || return 0
            echo "Error: Timezone required; use --timezone <ZONE>" >&2; return 1 ;;
        q|Q) echo "Timezone selection cancelled" >&2; return 1 ;;
        [1-7]) zone="${zones[$((choice - 1))]}" ;;
        8)
            printf 'IANA timezone (e.g. Europe/Paris): ' >&2
            if ! IFS= read -r zone; then
                [ "$optional" != optional ] || return 0
                echo "Error: Timezone required; use --timezone <ZONE>" >&2
                return 1
            fi
            if [ -z "$zone" ] && [ "$optional" = optional ]; then return 0; fi
            ;;
        *) echo "Error: Invalid timezone choice; select a number from 1 to 8" >&2; return 1 ;;
    esac
    valid_timezone "$zone" || { echo "Error: Invalid timezone" >&2; return 1; }
    printf '%s\n' "$zone"
}

set_timezone() {
    local name="$1" zone="$2" temp_timezone
    check_name "$name" >&2 || return 1
    valid_timezone "$zone" || { echo "Error: Invalid timezone" >&2; return 1; }
    mkdir -p -m 700 "$ACCOUNTS_DIR" "$TIMEZONES_DIR" || return 1
    chmod 700 "$TIMEZONES_DIR" || return 1
    temp_timezone=$(mktemp "$TIMEZONES_DIR/.timezone.XXXXXX") || return 1
    if ! printf '%s\n' "$zone" > "$temp_timezone" || ! chmod 600 "$temp_timezone" \
        || ! mv -f "$temp_timezone" "$TIMEZONES_DIR/$name"; then
        rm -f "$temp_timezone"
        return 1
    fi
}

# Locate the companion beside the deployed core, independently of credentials.
load_shell_companion() {
    local source_path="${BASH_SOURCE[0]}" directory library
    command -v jq >/dev/null 2>&1 || { echo "Error: jq is required for shell configuration" >&2; return 1; }
    directory=$(cd -- "$(dirname -- "$source_path")" && pwd -P) || return 1
    CCACC_ABSOLUTE_SCRIPT="$directory/$(basename -- "$source_path")"
    library="$directory/ccacc_shell.sh"
    [ -f "$library" ] && [ -r "$library" ] || {
        echo "Error: Install the readable ccacc_shell.sh companion beside $CCACC_ABSOLUTE_SCRIPT" >&2
        return 1
    }
    # The library defines functions only; sourcing it never launches Claude.
    . "$library" || { echo "Error: Could not load shell companion: $library" >&2; return 1; }
    declare -F ccacc_install_shell_hook >/dev/null && declare -F ccacc_check_shell_hook >/dev/null || {
        echo "Error: Invalid ccacc_shell.sh companion: installer or installed-check API is missing" >&2; return 1;
    }
}

# Read-only installation check before prompts, passwords or account changes.
require_shell_hook() {
    local SHELL="${SHELL:-/bin/bash}"
    if ! load_shell_companion || ! ccacc_check_shell_hook "$CCACC_ABSOLUTE_SCRIPT"; then
        echo "Error: Shell hook is not installed correctly; reinstall with: $INSTALL_COMMAND; account unchanged" >&2
        return 1
    fi
}

# Explicit bootstrap: no account, timezone, config or credentials are required.
configure_shell_command() {
    local SHELL="${SHELL:-/bin/bash}"
    load_shell_companion || return 1
    ccacc_install_shell_hook "$CCACC_ABSOLUTE_SCRIPT"
}

# Preflight only: validate every flag and resolve the required TZ before writes,
# passwords or account changes.
prepare_account_metadata() {
    local name="${1:-}" requested_zone="" zone_seen="" zone
    check_name "$name" || return 1
    shift
    PREPARED_TIMEZONE=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --timezone)
                [ "$#" -ge 2 ] && [ -z "$zone_seen" ] || {
                    echo "Error: --timezone requires one value and may appear only once" >&2; return 1;
                }
                requested_zone="$2"
                valid_timezone "$requested_zone" || { echo "Error: Invalid timezone" >&2; return 1; }
                zone_seen=yes
                ;;
            *) echo "Error: Expected --timezone <ZONE>" >&2; return 1 ;;
        esac
        shift 2
    done
    command -v jq >/dev/null || return 1
    validate_unnamed_session || return 1
    zone="$requested_zone"
    if [ -z "$zone" ]; then zone=$(timezone_command "$name") || zone=""; fi
    if [ -z "$zone" ]; then zone=$(choose_timezone "$name") || return 1; fi
    PREPARED_TIMEZONE="$zone"
}

save_prepared_metadata() {
    set_timezone "$1" "$PREPARED_TIMEZONE"
}

# Match executable names, not command arguments mentioning Claude paths.
claude_process_ids() {
    local processes current_uid
    current_uid=$(id -u) || return 1
    processes=$(ps -axo pid=,uid=,comm=) || return 1
    # Process names/arguments may contain arbitrary bytes, not valid UTF-8.
    printf '%s\n' "$processes" | LC_ALL=C awk -v uid="$current_uid" '
        $2 == uid && ($3 == "claude" || $0 ~ /\/claude$/ ||
            $0 ~ /\/\.local\/share\/claude\/versions\/[0-9][^\/[:space:]]*$/) { print $1 }
    '
}

# Stop every current-user Claude Code instance before saving or moving account state.
# Other config dirs (including emocode) are included; the desktop app is not.
stop_claude() {
    local pids pid signal attempt status guard=${1:-}
    if ! pids=$(claude_process_ids); then
        echo -e "${RED}Error: Could not inspect Claude Code processes; account not switched${NC}"
        return 1
    fi
    [ -n "$pids" ] || return 0

    echo -e "${YELLOW}Stopping all Claude Code processes for the current user${NC}"
    for signal in TERM KILL; do
        for pid in $pids; do
            if [ "$guard" = --guard-ancestors ]; then
                [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
                [ "$pid" -gt 1 ] || return 1
                status=0
                cleanup_process_is_ancestor "$pid" || status=$?
                [ "$status" -eq 1 ] || {
                    echo "Error: Cleanup process ancestry is unsafe or unverifiable; exit Claude and rerun" >&2
                    return 1
                }
            fi
            kill -"$signal" "$pid" 2>/dev/null || true
        done
        for attempt in 1 2 3 4 5; do
            if ! pids=$(claude_process_ids); then
                echo -e "${RED}Error: Could not verify Claude Code shutdown; account not switched${NC}"
                return 1
            fi
            [ -n "$pids" ] || return 0
            sleep 1
        done
        # Refresh the process list before escalating, including any restarted instances.
        if ! pids=$(claude_process_ids); then
            echo -e "${RED}Error: Could not verify Claude Code shutdown; account not switched${NC}"
            return 1
        fi
        [ -n "$pids" ] || return 0
    done

    echo -e "${RED}Error: Claude Code is still running; account not switched${NC}"
    return 1
}

# Function to point out Cowork device keys: Claude Code keeps them under one fixed keychain name
# shared by every config dir, so ccacc leaves them alone (checks existence only, never reads them)
note_device_keys() {
    if [ -e "$DEVICE_KEY_FILE" ] || { security find-generic-password -s "$DEVICE_KEY_SERVICE" > /dev/null 2>&1; }; then
        echo -e "${YELLOW}Note: Cowork device keys (${DEVICE_KEY_SERVICE}) are shared by all Claude Code config dirs and are not switched${NC}"
    fi
}

# Functions to read/write a macOS keychain secret (service, account)
keychain_read() {
    local status=0
    local secret
    secret=$(security find-generic-password -s "$1" -a "$2" -w 2>/dev/null) || status=$?

    # 44 = no such item
    if [ $status -eq 44 ]; then
        return 0
    elif [ $status -ne 0 ]; then
        return 1
    fi

    # security prints secrets containing non-ASCII bytes as hex
    if ! printf '%s' "$secret" | jq -e . > /dev/null 2>&1 && [[ "$secret" =~ ^[0-9a-f]+$ ]]; then
        secret=$(printf '%s' "$secret" | xxd -r -p)
    fi
    printf '%s' "$secret"
}

# security -i reads each command into a fixed line buffer. Measured on macOS
# (Darwin 27): lines of up to 4095 characters store intact, longer ones are
# silently truncated. Stay well below that.
SECURITY_INTERACTIVE_MAX_LINE=4000

# Write the item exactly as Claude Code does, through /usr/bin/security with -U
# and hex data. Items written by security keep its "apple-tool:" partition, so
# later security reads (ccacc's and Claude Code's) do not raise keychain
# prompts; writing through another program (e.g. osascript's SecItemUpdate)
# changes the partition and makes every following security read prompt.
keychain_write() {
    local service="$1" account="$2" secret="$3" hex line LC_ALL=C
    [ -n "$secret" ] || return 1
    # Names are double-quoted for the security -i parser; refuse anything it could misread.
    case "$service$account" in
        *'"'*|*'\'*|*$'\n'*|*$'\r'*)
            echo "Error: Unsupported keychain service or account name" >&2; return 1 ;;
    esac
    hex=$(printf '%s' "$secret" | xxd -p | tr -d '\n') && [ -n "$hex" ] || return 1
    line="add-generic-password -U -a \"$account\" -s \"$service\" -X $hex"
    if [ "${#line}" -le "$SECURITY_INTERACTIVE_MAX_LINE" ]; then
        # The secret travels on stdin only, never in argv.
        printf '%s\n' "$line" | security -i > /dev/null 2>&1 || return 1
    else
        # Too long for security -i: fall back to argv, as Claude Code does.
        echo "Warning: keychain item too large for 'security -i'; passing it to security as an argument (briefly visible in local process listings)" >&2
        security add-generic-password -U -a "$account" -s "$service" -X "$hex" > /dev/null 2>&1 || return 1
    fi

    [ "$(keychain_read "$service" "$account")" = "$secret" ]
}

# Functions to read/write/delete Claude Code's default credentials in the macOS keychain.
# `security -s` matches the service name exactly, so suffixed items are never affected
read_credentials() {
    keychain_read "$KEYCHAIN_SERVICE" "$USER"
}

write_credentials() {
    keychain_write "$KEYCHAIN_SERVICE" "$USER" "$1"
}

delete_credentials() {
    security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$USER" > /dev/null 2>&1 || true

    local left
    left=$(read_credentials) && [ -z "$left" ]
}

# Extract only the Claude login, including from older backups containing MCP OAuth.
# Empty credentials mean logged out; malformed data must fail before any write.
claude_login_only() {
    local content="$1"
    [ -n "$content" ] || content='{}'
    printf '%s' "$content" | jq -cse '
        if length != 1 or (.[0] | type) != "object" then error("invalid credentials")
        else .[0] |
            if .claudeAiOauth == null then {}
            elif (.claudeAiOauth | type) != "object" then error("invalid Claude login")
            else {claudeAiOauth} end
        end
    ' 2>/dev/null
}

# Keep live MCP OAuth and all unrelated fields; switch only the Claude login.
# Backups from versions that stored the whole Keychain item still carry mcpOAuth:
# write those entries back (they replace live entries for the same server) while
# keeping live entries the backup does not know about.
# Updating in place also retains the existing Keychain access rules.
replace_credentials() {
    local login current merged backup
    backup="$1"
    if ! login=$(claude_login_only "$backup") \
        || ! current=$(read_credentials); then
        echo -e "${RED}Error: Could not read the Claude login; credentials unchanged${NC}"
        return 1
    fi
    [ -n "$current" ] || current='{}'
    [ -n "$backup" ] || backup='{}'
    if ! merged=$(printf '%s\n%s\n%s\n' "$current" "$login" "$backup" | jq -cse '
        if length != 3 or (.[0] | type) != "object" or (.[2] | type) != "object" then error("invalid credentials")
        else
            (.[0] | del(.claudeAiOauth)) as $live
            | (if (.[2].mcpOAuth | type) == "object" and (.[2].mcpOAuth | length) > 0
               then $live + {mcpOAuth: (($live.mcpOAuth // {}) + .[2].mcpOAuth)}
               else $live end)
            + .[1]
        end
    ' 2>/dev/null); then
        echo -e "${RED}Error: Invalid current credentials; credentials unchanged${NC}"
        return 1
    fi

    if [ "$merged" = '{}' ]; then
        delete_credentials
    else
        write_credentials "$merged"
    fi
}

# Login backups are plain JSON files: <name>.credentials, mode 600, not encrypted.
# Earlier versions encrypted them as <name>.credentials.enc with one master password;
# migrate_encrypted_backups converts those once.
credentials_backup_file() {
    printf '%s/%s.credentials' "$ACCOUNTS_DIR" "$1"
}

read_backup() {
    local backup_file
    backup_file=$(credentials_backup_file "$1")

    if [ -f "$backup_file" ]; then
        cat "$backup_file"
    fi
}

# Write through a private temporary file in the same folder, then rename it into place.
write_plain_backup() {
    local target="$1" content="$2" temp_file

    temp_file=$(umask 077; mktemp "$ACCOUNTS_DIR/.credentials.XXXXXXXX") || return 1
    if ! printf '%s' "$content" > "$temp_file" || ! chmod 600 "$temp_file" \
        || ! mv -f "$temp_file" "$target"; then
        rm -f "$temp_file"
        return 1
    fi
    [ "$(cat "$target")" = "$content" ]
}

write_backup() {
    local name="$1"
    local kind="$2"
    local content="$3"

    if [ "$kind" = credentials ]; then
        if ! content=$(claude_login_only "$content"); then
            echo -e "${RED}Error: Invalid credentials; backup unchanged${NC}"
            return 1
        fi
        [ "$content" != '{}' ] || content=''
    fi

    if [ -z "$content" ]; then
        delete_backup "$name" "$kind" || return 1
        return 0
    fi

    write_plain_backup "$(credentials_backup_file "$name")" "$content"
}

delete_backup() {
    rm -f "$(credentials_backup_file "$1")"
}

# Decrypt one legacy backup with the master password. The password goes through
# fd 3, so it never shows up in the process list or on disk.
decrypt_legacy_backup() {
    openssl enc -d -aes-256-cbc -pbkdf2 -iter 100000 -md sha256 -pass fd:3 \
        -in "$1" 3< <(printf '%s\n' "$2") 2>/dev/null
}

# One-time migration of encrypted backups to plain files. Asks for the old master
# password only when <name>.credentials.enc files exist. Every backup is decrypted,
# checked and written before any encrypted file is removed, so a wrong password or
# a failure leaves the encrypted backups in place.
migrate_encrypted_backups() {
    local -a encrypted=()
    local file name target content password

    for file in "$ACCOUNTS_DIR"/*.credentials.enc; do
        if [ -f "$file" ] && [ ! -L "$file" ]; then encrypted+=("$file"); fi
    done
    if [ "${#encrypted[@]}" -eq 0 ]; then
        rm -f "$LEGACY_CHECK_FILE" || return 1
        return 0
    fi

    if ! command -v openssl > /dev/null 2>&1; then
        echo -e "${RED}Error: openssl is required once to migrate encrypted login backups; account unchanged${NC}"
        return 1
    fi
    echo "ccacc no longer encrypts login backups. Enter the old master password once to convert ${#encrypted[@]} encrypted backup(s) to plain files." >&2
    if ! IFS= read -r -s -p "ccacc master password: " password; then
        echo
        echo -e "${RED}Error: No master password given; encrypted backups unchanged${NC}"
        return 1
    fi
    echo
    if [ -f "$LEGACY_CHECK_FILE" ] && [ "$(decrypt_legacy_backup "$LEGACY_CHECK_FILE" "$password")" != "ccacc" ]; then
        echo -e "${RED}Error: Wrong master password; encrypted backups unchanged${NC}"
        return 1
    fi

    for file in "${encrypted[@]}"; do
        name=$(basename "$file" .credentials.enc)
        target=$(credentials_backup_file "$name")
        if ! content=$(decrypt_legacy_backup "$file" "$password") \
            || ! printf '%s' "$content" | jq -e 'type == "object"' > /dev/null 2>&1; then
            echo -e "${RED}Error: Could not decrypt the login backup of '${name}'; encrypted backups unchanged${NC}"
            return 1
        fi
        if [ -e "$target" ] || [ -L "$target" ]; then
            # Left by an interrupted earlier migration: keep it only if identical.
            if [ -f "$target" ] && [ ! -L "$target" ] && [ "$(cat "$target")" = "$content" ]; then continue; fi
            echo -e "${RED}Error: Both $target and its encrypted backup exist and differ; encrypted backups unchanged${NC}"
            return 1
        fi
        if ! write_plain_backup "$target" "$content"; then
            echo -e "${RED}Error: Could not write the login backup of '${name}'; encrypted backups unchanged${NC}"
            return 1
        fi
    done

    rm -f "${encrypted[@]}" "$LEGACY_CHECK_FILE" || return 1
    echo -e "${GREEN}Converted ${#encrypted[@]} login backup(s) to plain files in ~/.claude/accounts (not encrypted).${NC}" >&2
}

# Function to generate a fresh Claude Code identity (userID + anonymousId + machineID)
new_identity() {
    local user_id=$(od -An -v -tx1 -N32 /dev/urandom | tr -d ' \n')
    local machine_id=$(od -An -v -tx1 -N32 /dev/urandom | tr -d ' \n')
    local uuid
    uuid=$(uuidgen | tr '[:upper:]' '[:lower:]')

    jq -n --arg user_id "$user_id" --arg anonymous_id "claudecode.v1.${uuid}" --arg machine_id "$machine_id" \
        '{userID: $user_id, anonymousId: $anonymous_id, machineID: $machine_id}'
}

# Function to replace the account-bound keys of .claude.json with an account's saved ones
# (keys the account doesn't have are removed, so nothing of the previous account is left behind)
set_account_state() {
    local state="$1"
    local temp_config
    temp_config=$(mktemp) || return 1

    if ! jq --argjson keys "$ACCOUNT_KEYS" --argjson state "$state" \
        'with_entries(select(.key as $k | $keys | index($k) | not))
         + ($state | with_entries(select(.value != null)))' \
        "$CLAUDE_JSON" > "$temp_config"; then
        rm -f "$temp_config"
        return 1
    fi

    if ! cp "$temp_config" "$CLAUDE_JSON"; then
        rm -f "$temp_config"
        return 1
    fi
    rm -f "$temp_config"
}

# Function to reset the account-bound keys like a fresh install (the same resets cccleaner does), with new IDs
reset_account_state() {
    local temp_config
    temp_config=$(mktemp) || return 1
    local now=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")

    if ! jq --argjson ids "$(new_identity)" --arg now "$now" '
        def zero_leaves:
            if type == "object" then with_entries(.value |= zero_leaves)
            elif type == "array" then map(zero_leaves)
            else 0 end;
        def reset($key; $value): if has($key) then .[$key] = $value else . end;
        def zero($key): if has($key) then .[$key] |= zero_leaves else . end;

        del(.oauthAccount, .chromeExtension, .hasShownOpus45Notice, .userId, .user_id,
            .promoStartupStatusCache, .githubWebConnectionStatusCache, .apiCreditLinkStatusCache,
            .groveChoiceSeenAt, .cachedExperimentFeatures, .cachedExperimentData,
            .cachedExtraUsageDisabledReason, .cachedChromeExtensionInstalled,
            .additionalModelCostsCache, .modelAccessCache, .orgModelDefaultCache,
            .autoCompactWindowsCache, .additionalModelOptionsAnsweredAt,
            .seenNotifications, .announcementImpressions, .tipsHistoryByCommand,
            .promoStartupSeenCount, .rcLongTurnNudgeSeenCount, .rcLongTurnNudgeSeenKey,
            .bridgeOauthDeadExpiresAt, .bridgeOauthDeadFailCount,
            .claudeAiMcpEverConnected, .hasRemoteEnvironment, .mcpNeedsAuthNoticed,
            .hasAvailableSubscription, .penguinModeOrgEnabled,
            .cachedChangelog, .cachedStatsigGates, .cachedDynamicConfigs, .cachedGrowthBookFeatures,
            .cachedGrowthBookFeaturesAt, .metricsStatusCache, .clientDataCache, .clientDataCacheSlots,
            .cachedArtifactRoster, .cachedUsageUtilization,
            .additionalModelOptionsCache, .overageCreditGrantCache,
            .firstStartTime, .lastShownEmergencyTip, .companion, .lastOnboardingVersion, .lastReleaseNotesSeen,
            .githubRepoPaths, .replBridgePlaceholders)
        # Retain reusable project MCP definitions/selections while dropping
        # account history, trust and empty records. Explicit false is a choice.
        | .projects = ((.projects // {}) | with_entries(
            .value |= (if type == "object" then with_entries(select(.key as $key | [
                "mcpServers", "disabledMcpServers", "enabledMcpServers",
                "enabledMcpjsonServers", "disabledMcpjsonServers", "enableAllProjectMcpServers"
            ] | index($key))) else {} end)
            | .value |= with_entries(select(.value |
                type == "boolean" or ((type == "object" or type == "array") and length > 0)
            ))
        ) | with_entries(select(.value != {})))
        | reset("groveConfigCache"; {}) | reset("passesEligibilityCache"; {}) | reset("s1mAccessCache"; {})
        | reset("changelogLastFetched"; 0) | reset("lastPlanModeUse"; 0) | reset("passesUpsellSeenCount"; 0)
        | reset("passesLastSeenRemaining"; 0) | reset("numStartups"; 0) | reset("btwUseCount"; 0)
        | reset("promptQueueUseCount"; 0) | reset("opus1mMergeNoticeSeenCount"; 0)
        | reset("voiceNoticeSeenCount"; 0) | reset("slackAppInstallCount"; 0)
        | reset("autoPermissionsNotificationCount"; 0) | reset("remoteControlUpsellSeenCount"; 0)
        | reset("closedIssuesLastChecked"; 0) | reset("ideHintShownCount"; 0)
        | reset("opusProMigrationTimestamp"; 0)
        | reset("claudeCodeFirstTokenDate"; $now) | reset("routineFiredWatermark"; $now)
        | reset("skillUsage"; {}) | reset("toolUsage"; {})
        | zero("pluginUsage") | zero("agentLastUsed") | zero("feedbackSurveyState") | zero("tipLifetimeShownCounts")
        | if has("tipsHistory") then .tipsHistory |= with_entries(.value = 0) else . end
        | .hasCompletedOnboarding = false
        | . + $ids
    ' "$CLAUDE_JSON" > "$temp_config"; then
        rm -f "$temp_config"
        return 1
    fi

    if ! cp "$temp_config" "$CLAUDE_JSON"; then
        rm -f "$temp_config"
        return 1
    fi
    rm -f "$temp_config"
}

# Function to move the account-bound files and folders out of the way, into an account's backup folder
stash_paths() {
    local stash="$ACCOUNTS_DIR/$1"
    local entry label path

    mkdir -p -m 700 "$stash"
    for entry in "${ACCOUNT_PATHS[@]}"; do
        label="${entry%%|*}"
        path="${entry#*|}"

        # Clear any stale copy first, or mv would nest a folder inside it
        rm -rf "${stash:?}/${label:?}"
        if [ -e "$path" ] || [ -L "$path" ]; then
            mv "$path" "$stash/$label" || return 1
        fi
    done
}

# Function to move an account's files and folders back into place
unstash_paths() {
    local stash="$ACCOUNTS_DIR/$1"
    local entry label path

    for entry in "${ACCOUNT_PATHS[@]}"; do
        label="${entry%%|*}"
        path="${entry#*|}"

        if [ -e "$stash/$label" ] || [ -L "$stash/$label" ]; then
            rm -rf "${path:?}"
            mkdir -p "$(dirname "$path")"
            mv "$stash/$label" "$path" || return 1
        fi
    done
}

# Function to back up the current account (Claude login + account-bound keys) as <name>.
# Folders stay in place while the account is active; they are only moved when switching away
save_account() {
    local name="$1"
    local credentials

    if ! credentials=$(read_credentials); then
        echo -e "${RED}Error: Could not read the Claude login from $KEYCHAIN_SERVICE${NC}"
        return 1
    fi

    local temp_account=$(mktemp)
    if ! jq --argjson keys "$ACCOUNT_KEYS" 'with_entries(select(.key as $k | $keys | index($k)))' \
        "$CLAUDE_JSON" > "$temp_account" \
        || ! write_backup "$name" credentials "$credentials"; then
        rm -f "$temp_account"
        echo -e "${RED}Error: Could not back up account '${name}'${NC}"
        return 1
    fi

    mv "$temp_account" "$ACCOUNTS_DIR/${name}.json"
}

# Function to restore a saved account's credentials and account-bound keys
load_account() {
    local name="$1"
    local credentials

    # Read the backup before changing anything, so a bad backup leaves the current account in place
    if ! credentials=$(read_backup "$name" credentials); then
        echo -e "${RED}Error: Could not read the credentials backup of '${name}'${NC}"
        return 1
    fi
    if [ -n "$credentials" ] && ! printf '%s' "$credentials" | jq -e . > /dev/null 2>&1; then
        echo -e "${RED}Error: Credentials backup of '${name}' is not valid JSON${NC}"
        return 1
    fi

    if ! replace_credentials "$credentials" \
        || ! set_account_state "$(cat "$ACCOUNTS_DIR/${name}.json")"; then
        echo -e "${RED}Error: Failed to restore account '${name}'${NC}"
        return 1
    fi
}

# Function to find surge-cli; fails quietly when Surge isn't installed, so nothing is asked or shown
find_surge() {
    SURGE_CLI=$(command -v surge-cli || echo "$SURGE_APP/Contents/Applications/surge-cli")
    [ -x "$SURGE_CLI" ]
}

# Function to print Surge's select groups and their policies as {group: [policy, ...]} in profile order.
# Fails when Surge isn't running
surge_groups() {
    local members select_groups

    members=$("$SURGE_CLI" --raw dump policy-group-sub-policies 2>/dev/null) || return 1
    printf '%s' "$members" | jq -e '.map' > /dev/null 2>&1 || return 1

    # Only select groups can be switched; read their names from the effective profile
    select_groups=$("$SURGE_CLI" dump profile effective 2>/dev/null \
        | awk '/^\[/ { s = ($0 == "[Proxy Group]") }
               s && /=[[:space:]]*select([[:space:]]*,|[[:space:]]*$)/ { sub(/[[:space:]]*=.*/, ""); gsub(/^"|"$/, ""); print }' \
        | jq -R . | jq -sc .)

    printf '%s' "$members" | jq -c --argjson select "$select_groups" \
        '.map as $map | reduce $select[] as $g ({}; if $map[$g] then . + {($g): ($map[$g] | map(.name))} else . end)'
}

# Function to choose the Surge policies an account uses and save them as <name>.surge.
# Quiet when Surge isn't installed
setup_surge() {
    local name="$1"
    local groups current group policy answer index pick
    local picks="{}"
    local names=()

    find_surge || return 0
    if ! groups=$(surge_groups) || [ "$groups" = "{}" ]; then
        echo -e "${YELLOW}Note: Surge is not running, skipped its setup; run '$SCRIPT_NAME surge ${name}' later${NC}"
        return 0
    fi
    current=$("$SURGE_CLI" --raw environment 2>/dev/null | jq -c '.environment.ProxyGroupSelection // {}') || current="{}"
    if [ -f "$ACCOUNTS_DIR/${name}.surge" ]; then
        picks=$(jq -ce 'select(type == "object")' "$ACCOUNTS_DIR/${name}.surge" 2>/dev/null) || picks="{}"
    fi

    echo -e "${BLUE}Surge setup for '${name}'${NC} (select groups, current policy in brackets):"
    while IFS= read -r group; do
        names+=("$group")
        echo "  ${#names[@]}) ${group} [$(printf '%s' "$current" | jq -r --arg g "$group" '.[$g] // "-"')]"
    done < <(printf '%s' "$groups" | jq -r 'keys_unsorted[]')

    read -r -p "Groups to set for '${name}' (numbers separated by spaces, Enter to skip): " answer
    for index in $answer; do
        if ! [[ "$index" =~ ^[0-9]+$ ]] || [ "$index" -lt 1 ] || [ "$index" -gt ${#names[@]} ]; then
            echo -e "${YELLOW}Skipped '${index}': not a group number${NC}"
            continue
        fi

        group="${names[$((index - 1))]}"
        local policies=()
        while IFS= read -r policy; do
            policies+=("$policy")
            echo "    ${#policies[@]}) ${policy}"
        done < <(printf '%s' "$groups" | jq -r --arg g "$group" '.[$g][]')

        read -r -p "  Policy for ${group}: " pick
        if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le ${#policies[@]} ]; then
            picks=$(printf '%s' "$picks" | jq -c --arg g "$group" --arg p "${policies[$((pick - 1))]}" '. + {($g): $p}')
        else
            echo -e "${YELLOW}Skipped ${group}${NC}"
        fi
    done

    if [ "$picks" != "{}" ]; then
        if ! printf '%s\n' "$picks" > "$ACCOUNTS_DIR/${name}.surge"; then
            echo -e "${RED}Error: Could not save Surge policies for '${name}'${NC}" >&2
            return 1
        fi
        echo -e "${GREEN}Saved Surge policies for '${name}'${NC}"
    fi
}

# Function to switch Surge to an account's saved policies; quiet when Surge isn't installed
apply_surge() {
    local name="$1"
    local surge_file="$ACCOUNTS_DIR/${name}.surge"
    local groups valid entry
    local args=()

    if [ ! -f "$surge_file" ] || ! find_surge; then
        return 0
    fi
    if ! groups=$(surge_groups); then
        echo -e "${YELLOW}Warning: Surge is not running, Surge policies of '${name}' not applied${NC}"
        return 0
    fi

    # Surge only accepts a policy that is a member of the group
    while IFS=$'\t' read -r valid entry; do
        if [ "$valid" = "true" ]; then
            args+=("ProxyGroupSelection.${entry}")
        else
            echo -e "${YELLOW}Warning: Surge group '${entry%%=*}' has no policy '${entry#*=}', skipped${NC}"
        fi
    done < <(jq -r --argjson groups "$groups" \
        'to_entries[] | .key as $g | .value as $p | "\(($groups[$g] // []) | any(. == $p))\t\($g)=\($p)"' "$surge_file")

    if [ ${#args[@]} -eq 0 ]; then
        return 0
    fi

    if "$SURGE_CLI" --raw set "${args[@]}" 2>/dev/null | jq -e '.result == "success"' > /dev/null 2>&1; then
        local switched=$(printf '%s, ' "${args[@]#ProxyGroupSelection.}")
        echo -e "${GREEN}Switched Surge: ${switched%, }${NC}"
    else
        echo -e "${YELLOW}Warning: surge-cli set failed, Surge policies not switched${NC}"
    fi
}

# Retained profile transactions are unresolved recovery, never ordinary backups.
profile_recovery_path() {
    local path
    for path in "$ACCOUNTS_DIR"/.profile-transaction.*; do
        if [ -e "$path" ] || [ -L "$path" ]; then
            printf '%s\n' "$path"
            return 0
        fi
    done
    return 1
}

# Function to print the active account name (empty if none)
active_account() {
    [ ! -e "$CLEANUP_RECOVERY_DIR" ] && [ ! -L "$CLEANUP_RECOVERY_DIR" ] || return 0
    if profile_recovery_path >/dev/null; then return 0; fi
    if [ -f "$ACTIVE_FILE" ]; then
        local name
        name=$(jq -Rser 'select(test("^[A-Za-z0-9][A-Za-z0-9._-]*\\n?\\z")) | rtrimstr("\n")' "$ACTIVE_FILE" 2>/dev/null) || return 0
        if check_name "$name" >/dev/null 2>&1 && [ -f "$ACCOUNTS_DIR/${name}.json" ]; then
            echo "$name"
        fi
    fi
}

# Function to back up the active account before switching away from it.
# Refuses when no account is active: the current state and history belong to nobody and would be lost
backup_active() {
    local active=$(active_account)

    if [ -z "$active" ]; then
        echo -e "${RED}Error: The current Claude account is not saved yet${NC}"
        echo "Run '$SCRIPT_NAME save <name>' first"
        return 1
    fi

    save_account "$active"
}

# Function to describe the current account
current_email() {
    local email=$(jq -r '.oauthAccount.emailAddress // empty' "$CLAUDE_JSON")
    echo "${email:-not logged in}"
}

# Print a saved profile's Claude plan, e.g. "Ultra", "Team" or "Max 5x"; empty
# when unknown. Reads only the saved oauthAccount metadata, never credentials.
# The server's own planDisplayName wins; otherwise the organization type names
# the plan. Printable ASCII only, so it is safe to render in the picker.
account_plan_label() {
    jq -r '
        (.oauthAccount? | if type == "object" then . else {} end) as $account
        | def text($v): if ($v | type) == "string" then $v else "" end;
        if text($account.planDisplayName) != "" then text($account.planDisplayName)
        else
            ({claude_team: "Team", claude_enterprise: "Enterprise", claude_pro: "Pro", claude_max: "Max"}
                [text($account.organizationType)] // "") as $plan
            | (first(text($account.organizationRateLimitTier) | capture("_(?<size>[0-9]+x)$") | .size) // null) as $size
            | if $plan == "Max" and $size then "Max \($size)" else $plan end
        end
        | gsub("[^ -~]"; "?") | .[0:40]' "$1" 2>/dev/null
}

# Function to list saved accounts
list_accounts() {
    check_ready
    echo -e "${BLUE}Saved accounts${NC} (${CONFIG_DIR}):"

    local active=$(active_account)
    local found=0
    for file in "$ACCOUNTS_DIR"/*.json; do
        if [ -f "$file" ]; then
            found=1
            local name=$(basename "$file" .json)
            local email=$(jq -r '.oauthAccount.emailAddress // "not logged in"' "$file")
            local plan=$(account_plan_label "$file")
            email="${CYAN}${email}${NC}"
            [ -z "$plan" ] || email="$email ${MAGENTA}[$plan]${NC}"
            local surge=""
            if [ -f "$ACCOUNTS_DIR/${name}.surge" ]; then
                surge=" [Surge: $(jq -r 'to_entries | map("\(.key)=\(.value)") | join(", ")' "$ACCOUNTS_DIR/${name}.surge")]"
            fi
            if [ "$name" = "$active" ]; then
                echo -e "  ${GREEN}* ${name}${NC} ${email}${surge} (active)"
            else
                echo -e "  ${YELLOW}  ${name}${NC} ${email}${surge}"
            fi
        fi
    done

    if [ $found -eq 0 ]; then
        echo "No accounts saved. Save the current one with: $SCRIPT_NAME save <name>"
    fi
}

# Function to show the current account
show_current() {
    check_ready
    local active=$(active_account)
    echo -e "Account:    $(current_email)"
    echo -e "Saved as:   ${active:-(not saved)}"
    echo -e "Config dir: ${CONFIG_DIR}"
}

# Save/delete stage only their bounded profile/session paths. Runtime consent is
# moved first and restored last, after all account metadata has been restored.
# Caller locals contain the transaction directory, entries and commit state.
_ccacc_profile_tx_preflight() {
    local entry path kind index
    for entry in "${_ccacc_profile_tx_entries[@]}"; do
        kind=${entry%%|*}; path=${entry#*|}
        if ! _ccacc_shell_path "$path" "$kind" || ! cleanup_file_is_writable "$path"; then
            echo "Error: Unsafe or unwritable profile transaction path; account unchanged: $path" >&2
            return 1
        fi
    done
    _ccacc_profile_tx_dir=$(mktemp -d "$ACCOUNTS_DIR/.profile-transaction.XXXXXXXX") || return 1
    if ! (
        set -o pipefail
        for ((index=0; index<${#_ccacc_profile_tx_entries[@]}; index++)); do
            entry=${_ccacc_profile_tx_entries[index]}; kind=${entry%%|*}; path=${entry#*|}
            jq -cn --arg source "$path" --arg staged "$_ccacc_profile_tx_dir/$index" --arg kind "$kind" \
                '{source:$source, staged:$staged, kind:$kind}' || exit 1
        done | jq -s . > "$_ccacc_profile_tx_dir/manifest.json"
    ); then
        rm -rf -- "$_ccacc_profile_tx_dir"
        _ccacc_profile_tx_dir=''
        return 1
    fi
}

_ccacc_profile_tx_stage() {
    local index path
    for ((index=0; index<${#_ccacc_profile_tx_entries[@]}; index++)); do
        path=${_ccacc_profile_tx_entries[index]#*|}
        if [ -e "$path" ] || [ -L "$path" ]; then
            mv "$path" "$_ccacc_profile_tx_dir/$index" || return 1
        fi
    done
}

_ccacc_profile_tx_finish() {
    local index entry path kind failed=''
    [ -n "$_ccacc_profile_tx_dir" ] || return 0
    if [ "$_ccacc_profile_tx_committed" = yes ]; then
        rm -rf -- "$_ccacc_profile_tx_dir" || {
            echo "Warning: Profile change committed; private staged data retained at $_ccacc_profile_tx_dir" >&2
        }
        return 0
    fi
    for ((index=${#_ccacc_profile_tx_entries[@]}-1; index>=0; index--)); do
        entry=${_ccacc_profile_tx_entries[index]}; kind=${entry%%|*}; path=${entry#*|}
        # Never re-enable consent when any account metadata could not recover.
        if [ "$path" = "$LAUNCH_MODE_FILE" ] && [ -n "$failed" ]; then continue; fi
        if [ -e "$_ccacc_profile_tx_dir/$index" ] || [ -L "$_ccacc_profile_tx_dir/$index" ]; then
            if [ -e "$path" ] || [ -L "$path" ]; then
                if [ "$_ccacc_profile_tx_writes" != yes ] || [ "$kind" != file ] \
                    || ! _ccacc_shell_path "$path" file || ! rm -f "$path"; then
                    failed=yes; continue
                fi
            fi
            mv "$_ccacc_profile_tx_dir/$index" "$path" || failed=yes
        elif [ "$_ccacc_profile_tx_writes" = yes ]; then
            _ccacc_shell_path "$path" file && rm -f "$path" || failed=yes
        fi
    done
    if [ -z "$failed" ]; then rm -rf -- "$_ccacc_profile_tx_dir"
    else
        echo "Error: Profile operation failed and rollback incomplete; runtime choice stays disabled where staged; restore manifest.json paths from $_ccacc_profile_tx_dir before retrying" >&2
    fi
}

# save and use must not change the login under a running Claude Code, so they ask
# before closing it: only when it is running, and only on a terminal. $1 is the
# command name for messages (save or use).
confirm_close_claude() {
    local command="$1" pids answer=''
    if ! pids=$(claude_process_ids); then
        echo "Error: Could not inspect Claude Code processes; nothing changed" >&2
        return 1
    fi
    [ -n "$pids" ] || return 0
    if [ ! -t 0 ] || [ ! -t 2 ]; then
        echo "Error: Claude Code is running; quit it, or run '$SCRIPT_NAME $command' in a terminal to close it, then retry" >&2
        return 1
    fi
    printf 'Claude Code is running. Close it now? (y/N) ' >&2
    if ! IFS= read -r answer; then answer=''; fi
    case "$answer" in
        y|Y|yes|YES|Yes) ;;
        *) echo "Cancelled; Claude Code left running and nothing changed." >&2; return 1 ;;
    esac
    # Never stop the Claude Code session that is running this command.
    stop_claude --guard-ancestors >&2 || { echo "Error: Claude Code was not closed; nothing changed" >&2; return 1; }
}

# Function to save the current account as <name>
save_command() (
    local name="${1:-}"
    local _ccacc_profile_tx_dir='' _ccacc_profile_tx_committed='' _ccacc_profile_tx_writes=''
    local -a _ccacc_profile_tx_entries
    umask 077
    check_name "$name" || return 1
    load_shell_companion || return 1
    cleanup_is_complete || return 1
    # Only the active profile may be refreshed under its own name. Any other
    # existing profile is refused before any prompt, password or mutation.
    if profile_exists "$name" && [ "$(active_account)" != "$name" ]; then
        echo "Error: Account '$name' already exists and is not active; choose another name, or run '$SCRIPT_NAME use $name' / '$SCRIPT_NAME rm $name' first" >&2
        return 1
    fi
    prepare_account_metadata "$@" || return 1
    check_ready || return 1
    confirm_close_claude save || return 1
    # Every successful save invalidates current runtime consent, even for the
    # same name: the current login may be a different identity. Nothing about
    # launch permissions is stored in the named profile backup.
    _ccacc_profile_tx_entries=("file|$LAUNCH_MODE_FILE" "file|$ACTIVE_FILE"
        "file|$ACCOUNTS_DIR/$name.json" "file|$ACCOUNTS_DIR/$name.credentials"
        "file|$TIMEZONES_DIR/$name" "file|$LEGACY_PENDING_TIMEZONE_FILE" "file|$UNNAMED_SESSION_FILE")
    if [ ! -f "$ACCOUNTS_DIR/$name.surge" ]; then
        _ccacc_profile_tx_entries+=("file|$ACCOUNTS_DIR/$name.surge")
    fi
    _ccacc_profile_tx_preflight || return 1
    trap '_ccacc_profile_tx_finish' EXIT
    trap 'exit 130' INT
    # Before staging, so the transaction stages and can restore the converted backup.
    migrate_encrypted_backups || return 1
    _ccacc_profile_tx_stage || return 1
    _ccacc_profile_tx_writes=yes
    save_prepared_metadata "$name" || return 1
    save_account "$name" || return 1
    printf '%s\n' "$name" > "$ACTIVE_FILE" || return 1
    rm -f "$LEGACY_PENDING_TIMEZONE_FILE" "$UNNAMED_SESSION_FILE" || return 1
    if [ ! -f "$ACCOUNTS_DIR/${name}.surge" ]; then
        setup_surge "$name" || return 1
        apply_surge "$name" || return 1
    fi
    _ccacc_profile_tx_committed=yes
    echo -e "${GREEN}Saved Claude account ($(current_email)) as: ${name}${NC}"
)

# Completed backup metadata only: inspect the outgoing stash, never live target
# paths or credential/config values. Call only after save_account and stash_paths succeed.
report_outgoing_backup() {
    local outgoing="$1" stash="$ACCOUNTS_DIR/$1" entry label path found=false
    printf "Backed up outgoing account to profile '%s'.\n" "$outgoing" >&2
    printf 'Saved contents:\n' >&2
    if [ -f "$ACCOUNTS_DIR/$outgoing.credentials" ]; then
        printf '  - Claude login backup (plain file, not encrypted): ~/.claude/accounts/%s.credentials\n' "$outgoing" >&2
    else
        printf '  - No Claude login to back up (logged out); no login backup.\n' >&2
    fi
    printf '  - Account configuration snapshot: ~/.claude/accounts/%s.json\n' "$outgoing" >&2
    printf '  - Archived account history/session/cache paths:\n' >&2
    for entry in "${ACCOUNT_PATHS[@]}"; do
        label="${entry%%|*}"
        path="$stash/$label"
        if [ -e "$path" ] || [ -L "$path" ]; then
            printf '      %s: %s\n' "$label" "~${path#"$HOME"}" >&2
            found=true
        fi
    done
    if [ "$found" = false ]; then printf '      (none archived)\n' >&2; fi
    printf 'Saved timezone (TZ) and Surge choices remain unchanged.\n' >&2
}

# Any trace of a named profile (backup, login, timezone or history stash), even a
# broken symlink, means the name is taken.
profile_exists() {
    local path
    for path in "$ACCOUNTS_DIR/$1.json" "$ACCOUNTS_DIR/$1.credentials" "$ACCOUNTS_DIR/$1.credentials.enc" \
        "$TIMEZONES_DIR/$1" "$ACCOUNTS_DIR/$1"; do
        if [ -e "$path" ] || [ -L "$path" ]; then return 0; fi
    done
    return 1
}

# Print the alwaysYOLO setting (true/false). A missing file or key means false.
# Fail closed: an unreadable or malformed file, or a non-boolean value, is an error.
read_always_yolo() {
    local value
    if [ ! -e "$SETTINGS_FILE" ] && [ ! -L "$SETTINGS_FILE" ]; then
        printf 'false\n'
        return 0
    fi
    if value=$(jq -sr 'if length == 1 and (.[0] | type) == "object"
            and ((.[0] | has("alwaysYOLO") | not) or (.[0].alwaysYOLO | type) == "boolean")
        then .[0].alwaysYOLO // false else error("invalid") end' "$SETTINGS_FILE" 2>/dev/null) \
        && { [ "$value" = true ] || [ "$value" = false ]; }; then
        printf '%s\n' "$value"
        return 0
    fi
    echo "Error: Invalid settings file $SETTINGS_FILE; expected a readable JSON object whose optional alwaysYOLO is true or false; account unchanged" >&2
    return 1
}

# Shared by discovery and the final selected-target check; never reads credentials.
valid_saved_account() {
    check_name "$1" >/dev/null 2>&1 && [ -f "$ACCOUNTS_DIR/$1.json" ] \
        && [ ! -L "$ACCOUNTS_DIR/$1.json" ] \
        && jq -se 'length == 1 and (.[0] | type) == "object"' \
            "$ACCOUNTS_DIR/$1.json" >/dev/null 2>&1
}

# Read-only terminal UI. stdout is exclusively the chosen safe name, so command
# substitution and redirected caller stdout both work. Keep ISIG enabled for
# Ctrl-C and restore the exact terminal state on every exit (including signals).
pick_saved_account() (
    local file name email plan zone active='' selected=0 index start end key suffix
    local tty_state='' size rows=24 columns=80 page first
    local screen=false resized=false read_status interrupted=0 read_started
    local LC_ALL=C
    local -a names plans emails zones
    # Colour only the picker's own text; NO_COLOR (any value) turns it off.
    local c_title=$'\033[1m' c_name=$'\033[1m' c_active=$'\033[32m' c_sep=$'\033[2m'
    local c_plan=$'\033[1;35m' c_email=$'\033[36m' c_zone=$'\033[33m' c_hint=$'\033[2m'
    if [ -n "${NO_COLOR:-}" ]; then
        c_title='' c_name='' c_active='' c_sep='' c_plan='' c_email='' c_zone='' c_hint=''
    fi
    # A local SECONDS loses its clock behavior in Bash 3.2. This assignment is
    # confined to the picker subshell and keeps Bash's elapsed-time variable.
    SECONDS=0
    if [ ! -t 0 ] || [ ! -t 2 ]; then
        echo "Error: ccacc use without a name requires a terminal; use 'ccacc use <name> [--yolo|--no-yolo]'" >&2
        return 1
    fi
    command -v jq >/dev/null 2>&1 || { echo "Error: jq is required" >&2; return 1; }
    # A symlinked marker is not trusted for display or initial selection.
    if [ -f "$ACTIVE_FILE" ] && [ ! -L "$ACTIVE_FILE" ]; then
        active=$(jq -Rser 'select(test("^[A-Za-z0-9][A-Za-z0-9._-]*\\n?\\z"))
            | rtrimstr("\n")' "$ACTIVE_FILE" 2>/dev/null) || active=''
    fi
    names=() plans=() emails=() zones=()
    for file in "$ACCOUNTS_DIR"/*.json; do
        name=${file##*/}; name=${name%.json}
        valid_saved_account "$name" || continue
        # Printable ASCII only: saved metadata cannot inject terminal escapes,
        # newlines, bidi controls or shell code. Cap before rendering, too.
        email=$(jq -r '(.oauthAccount? | if type == "object" then .emailAddress else null end)
            | if type == "string" then gsub("[^ -~]"; "?") | .[0:160] else "" end' "$file") || email=''
        plan=$(account_plan_label "$file") || plan=''
        zone=''
        if [ -f "$TIMEZONES_DIR/$name" ] && [ ! -L "$TIMEZONES_DIR/$name" ]; then
            zone=$(read_timezone_file "$TIMEZONES_DIR/$name") || zone=''
        fi
        index=${#names[@]}
        names[index]=$name; plans[index]=$plan; emails[index]=$email; zones[index]=$zone
        [ "$name" != "$active" ] || selected=$index
    done
    if [ "${#names[@]}" -eq 0 ]; then
        echo "No saved profiles. Save the current account with: ccacc save <name> --timezone <ZONE>" >&2
        return 1
    fi
    exec 3< /dev/tty || return 1
    tty_state=$(stty -g <&3) || return 1
    # All helpers live in this subshell. EXIT also covers render/read failures;
    # leave the alternate buffer before the caller can display normal prompts.
    _ccacc_picker_cleanup() {
        trap '' PIPE
        if [ "$screen" = true ]; then
            # 1049 can restore saved cursor attributes: reset/show again on the
            # primary screen as well as before leaving the alternate screen.
            printf '\033[0m\033[?25h\033[?1049l\033[0m\033[?25h' >&2 || :
        fi
        stty "$tty_state" <&3 2>/dev/null || :
    }
    trap '_ccacc_picker_cleanup' EXIT
    # Let an in-progress Bash read finish restoring its temporary modes before
    # EXIT restores ours; exiting directly inside its signal trap can leave
    # Bash 3.2 in the intermediate (no-echo/noncanonical) state.
    trap 'interrupted=130' INT
    trap 'interrupted=129' HUP
    trap 'interrupted=143' TERM
    trap 'exit 1' PIPE
    # No rendering inside a signal trap: read can be interrupted safely and the
    # next frame obtains the new dimensions, even if WINCH arrives mid-frame.
    trap 'resized=true' WINCH
    _ccacc_picker_line() {
        # No newlines, including at the right/bottom edge. Absolute positioning
        # clears pending autowrap before another printable character is sent.
        printf '\033[%s;1H' "$1" >&2 && printf '%s%-*.*s\033[0m' "${3:-}" "$columns" "$columns" "$2" >&2
    }
    # One coloured piece of a profile row, cut to the columns still left, so an
    # escape sequence is never split and the row never wraps. Every piece starts
    # from a reset and reapplies the row's reverse video, if any.
    _ccacc_picker_piece() {
        local text="$2"
        [ "$left" -gt 0 ] || return 0
        text=${text:0:left}
        printf '\033[0m%s%s%s' "$base" "$1" "$text" >&2 || return 1
        left=$((left - ${#text}))
    }
    _ccacc_picker_row() {
        local index="$2" base='' left=$columns marker=' '
        [ "$index" -ne "$selected" ] || { base=$'\033[7m'; marker='>'; }
        printf '\033[%s;1H' "$1" >&2 || return 1
        _ccacc_picker_piece '' "$marker " || return 1
        _ccacc_picker_piece "$c_name" "${names[index]}" || return 1
        if [ "${names[index]}" = "$active" ]; then _ccacc_picker_piece "$c_active" ' (active)' || return 1; fi
        if [ -n "${plans[index]}" ]; then
            _ccacc_picker_piece "$c_sep" ' | ' && _ccacc_picker_piece "$c_plan" "${plans[index]}" || return 1
        fi
        if [ -n "${emails[index]}" ]; then
            _ccacc_picker_piece "$c_sep" ' | ' && _ccacc_picker_piece "$c_email" "${emails[index]}" || return 1
        fi
        if [ -n "${zones[index]}" ]; then
            _ccacc_picker_piece "$c_sep" ' | ' && _ccacc_picker_piece "$c_zone" "TZ=${zones[index]}" || return 1
        fi
        printf '\033[0m%s%*s\033[0m' "$base" "$left" '' >&2
    }
    _ccacc_picker_render() {
        size=$(stty size <&3 2>/dev/null) || return 1
        if [[ "$size" =~ ^[0-9]+[[:space:]][0-9]+$ ]]; then
            rows=${size% *}; columns=${size#* }
        fi
        [ "$rows" -gt 0 ] || rows=24
        [ "$columns" -gt 0 ] || columns=80
        first=1; page=1
        if [ "$rows" -ge 5 ]; then
            first=3; page=$((rows - 4))
        elif [ "$rows" -ge 3 ]; then first=2; fi
        start=$((selected / page * page)); end=$((start + page))
        [ "$end" -le "${#names[@]}" ] || end=${#names[@]}
        printf '\033[0m\033[2J\033[H' >&2 || return 1
        if [ "$rows" -ge 3 ]; then
            _ccacc_picker_line 1 'Choose saved profile' "$c_title" || return 1
        fi
        for ((index=start; index<end; index++)); do
            _ccacc_picker_row "$((first + index - start))" "$index" || return 1
        done
        if [ "$rows" -ge 4 ]; then
            _ccacc_picker_line "$((rows - 1))" "Profiles $((start + 1))-$end of ${#names[@]} | Selected: ${names[selected]}" "$c_hint" || return 1
        fi
        if [ "$rows" -ge 2 ]; then
            _ccacc_picker_line "$rows" 'Up/Down j/k: move | Return: select | q/Esc: cancel' "$c_hint" || return 1
        fi
    }
    # Suppress echo even between reads and while drawing. Keep ISIG enabled.
    stty -echo <&3 || return 1
    screen=true
    printf '\033[?1049h\033[?25l' >&2 || return 1
    while :; do
        [ "$interrupted" -eq 0 ] || return "$interrupted"
        resized=false
        _ccacc_picker_render || return 1
        [ "$resized" = false ] || continue
        key=''; read_status=1
        while :; do
            [ "$interrupted" -eq 0 ] || return "$interrupted"
            [ "$resized" = false ] || break
            key=''; read_status=0; read_started=$SECONDS
            IFS= read -r -s -n 1 -t 1 key <&3 || read_status=$?
            [ "$interrupted" -eq 0 ] || return "$interrupted"
            [ "$read_status" -ne 0 ] || break
            [ "$resized" = false ] || break
            # Bash 3.2 returns 1 for both timeout and EOF (newer Bash uses
            # >128 for timeout). An immediate read failure still exits. Polling
            # bounds idle WINCH/signal handling to one second without repainting.
            if [ "$SECONDS" -gt "$read_started" ]; then continue; fi
            return 1
        done
        [ "$read_status" -eq 0 ] || continue
        case "$key" in
            '') printf '%s\n' "${names[selected]}"; return 0 ;;
            q|$'\004') return 1 ;;
            $'\033')
                # Bash 3.2 supports integer read timeouts. A bare Esc cancels
                # after at most one second; accept CSI and application arrows.
                suffix=''
                if IFS= read -r -s -n 1 -t 1 suffix <&3 && { [ "$suffix" = '[' ] || [ "$suffix" = O ]; }; then
                    key=''
                    IFS= read -r -s -n 1 -t 1 key <&3 || key=''
                    case "$key" in A) key=k ;; B) key=j ;; *) key=ignored ;; esac
                else
                    [ "$interrupted" -eq 0 ] || return "$interrupted"
                    [ "$resized" = false ] || continue
                    return 1
                fi ;;
        esac
        case "$key" in
            j) selected=$(((selected + 1) % ${#names[@]})) ;;
            k) selected=$(((selected + ${#names[@]} - 1) % ${#names[@]})) ;;
        esac
    done
)

# Function to switch to a saved account
use_command() (
    local name='' name_seen=false zone active mode=false answer='' staged_mode='' mode_option='' status
    local always_yolo
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yolo|--no-yolo)
                [ -z "$mode_option" ] || { echo "Error: Duplicate or conflicting launch mode options" >&2; return 1; }
                mode_option="$1"
                if [ "$1" = --yolo ]; then mode=true; fi ;;
            -*) echo "Error: Unknown use option '$1'; expected --yolo or --no-yolo" >&2; return 1 ;;
            *)
                [ "$name_seen" = false ] || { echo "Error: use accepts at most one account name" >&2; return 1; }
                check_name "$1" >&2 || return 1
                name="$1"; name_seen=true ;;
        esac
        shift
    done
    # Settings are read before any picker, password, process stop or account change.
    always_yolo=$(read_always_yolo) || return 1
    require_shell_hook || return 1
    cleanup_is_complete || return 1
    trap 'exit 130' INT
    if [ "$name_seen" = false ]; then
        status=0
        name=$(pick_saved_account) || status=$?
        [ "$status" -eq 0 ] || return "$status"
    fi
    check_name "$name" || return 1
    if [ ! -f "$ACCOUNTS_DIR/${name}.json" ]; then
        echo -e "${RED}Error: Account '${name}' not found${NC}"
        list_accounts
        return 1
    fi
    if ! valid_saved_account "$name"; then
        echo "Error: Invalid saved account '$name'; account unchanged" >&2
        return 1
    fi
    zone=$(timezone_command "$name") || {
        echo "Error: No valid saved timezone for '$name'; remove it with '$SCRIPT_NAME rm $name' and save the login again with --timezone <ZONE>" >&2
        return 1
    }
    check_ready || return 1
    active=$(active_account)
    if [ "$active" != "$name" ] && [ -z "$active" ] && ! clean_unnamed_session; then
        echo "Error: Current login/history is not saved; run '$SCRIPT_NAME save <name>' first" >&2
        return 1
    fi
    # Validate and stage this session record before migration or process/account
    # mutations. A failed selection leaves the previous launch mode untouched.
    _ccacc_shell_path "$LAUNCH_MODE_FILE" file && cleanup_file_is_writable "$LAUNCH_MODE_FILE" || {
        echo "Error: Current launch mode cannot be safely updated; account unchanged" >&2; return 1;
    }
    validate_unnamed_session && cleanup_file_is_writable "$UNNAMED_SESSION_FILE" || return 1
    trap '[ -z "$staged_mode" ] || rm -f "$staged_mode"' EXIT
    if [ -z "$mode_option" ] && [ "$always_yolo" = true ]; then
        # An explicit opt-in: applies to terminal and noninteractive use alike.
        mode=true
        echo "YOLO enabled by alwaysYOLO in $SETTINGS_FILE (use --no-yolo to override)" >&2
    elif [ -z "$mode_option" ] && [ -t 0 ] && [ -t 2 ]; then
        printf 'YOLO? (y/N) ' >&2
        if { IFS= read -r answer < /dev/tty; } 2>/dev/null; then
            case "$answer" in y|Y|[yY][eE][sS]) mode=true ;; esac
        fi
    fi
    staged_mode=$(umask 077; mktemp "$ACCOUNTS_DIR/.launch-mode.XXXXXXXX") || return 1
    jq -cn --arg account "$name" --argjson yolo "$mode" \
        '{version:1,account:$account,yolo:$yolo}' > "$staged_mode" && chmod 600 "$staged_mode" || return 1
    if [ "$active" = "$name" ]; then
        mv -f "$staged_mode" "$LAUNCH_MODE_FILE" || return 1
        rm -f "$UNNAMED_SESSION_FILE" || return 1
        echo -e "${YELLOW}'${name}' is already active${NC}"
        # Re-apply the saved Surge policies, undoing manual changes in Surge.
        apply_surge "$name" || return 1
        return 0
    fi
    confirm_close_claude use || return 1
    migrate_encrypted_backups || return 1
    stop_claude || return 1
    note_device_keys
    if [ -n "$active" ]; then backup_active || return 1; fi
    load_account "$name" || return 1
    if [ -n "$active" ]; then
        stash_paths "$active" || return 1
        report_outgoing_backup "$active"
    fi
    unstash_paths "$name" || return 1
    echo "$name" > "$ACTIVE_FILE" || return 1
    rm -f "$LEGACY_PENDING_TIMEZONE_FILE" || return 1
    apply_surge "$name" || return 1
    mv -f "$staged_mode" "$LAUNCH_MODE_FILE" || return 1
    rm -f "$UNNAMED_SESSION_FILE" || return 1
    echo -e "${GREEN}Switched to Claude account: ${name} ($(current_email))${NC}"
)

# Cleanup never signals a PID taken from a config record. Ancestors and
# unverifiable process snapshots must block cleanup rather than kill the caller.
cleanup_process_is_ancestor() {
    local candidate="$1" current=$$ parent
    while [ "$current" -gt 1 ]; do
        [ "$candidate" != "$current" ] || return 0
        parent=$(ps -p "$current" -o ppid= 2>/dev/null) || return 2
        parent=${parent//[[:space:]]/}
        [[ "$parent" =~ ^[0-9]+$ ]] && [ "$parent" != "$current" ] || return 2
        current=$parent
    done
    return 1
}

cleanup_stop_processes() {
    stop_claude --guard-ancestors
}

cleanup_runtime_is_safe() {
    local processes status pids pid
    processes=$(ps -ax -o pid=,comm=,args= 2>/dev/null) && [ -n "$processes" ] || return 1
    status=0
    printf '%s\n' "$processes" | LC_ALL=C awk '
        NF < 2 || $1 !~ /^[0-9]+$/ { invalid = 1 }
        {
            command = $2; sub(/^.*\//, "", command)
            desktop_path = ($0 ~ /\/Claude[.]app\//)
            if (desktop_path) desktop = 1
            if (command == "claude" || command == "Claude" || command ~ /^claude-(daemon|bridge|background)$/ ||
                desktop_path || $0 ~ /\/\.claude\/(daemon|jobs|sessions|ide)\// ||
                (command ~ /^(node|bun|deno)$/ && $0 ~ /(\/\.claude\/|@anthropic-ai\/claude-code)/)) live = 1
        }
        END {
            if (desktop) {
                print "Warning: Claude.app or one of its helpers is running; using Claude.app alongside ccacc is not recommended." > "/dev/stderr"
                print "Fully quit Claude.app and any browser running its extension, then retry." > "/dev/stderr"
            }
            if (invalid) exit 2; if (live) exit 0; exit 1
        }
    ' || status=$?
    [ "$status" -eq 1 ] || return 1
    if [ -f "$CLAUDE_JSON" ]; then
        pids=$(jq -r '(.replBridgePlaceholders // {}) | to_entries[] | .value.pid
            | if type == "number" and . > 0 and floor == . then . else error("unverifiable bridge PID") end' "$CLAUDE_JSON") || return 1
        for pid in $pids; do
            # A successful full snapshot must prove each recorded owner absent.
            if printf '%s\n' "$processes" | LC_ALL=C awk -v pid="$pid" '$1 == pid { found = 1 } END { exit !found }'; then return 1; fi
        done
    fi
}

cleanup_path_is_safe() {
    local path="$1" kind=file
    [ ! -d "$path" ] || kind=dir
    _ccacc_shell_path "$path" "$kind"
}

# A saved name is history ownership only when its saved identity matches the
# current account. A stale marker must never overwrite another profile stash.
cleanup_matching_active() {
    local active
    active=$(active_account)
    [ -n "$active" ] && [ -f "$CLAUDE_JSON" ] || return 0
    if jq -n -e --slurpfile current "$CLAUDE_JSON" --slurpfile saved "$ACCOUNTS_DIR/$active.json" '
        ($current[0].userID // $current[0].userId // $current[0].user_id) as $c
        | ($saved[0].userID // $saved[0].userId // $saved[0].user_id) as $s
        | [$c, $s] as $users
        | [$current[0].oauthAccount.accountUuid, $saved[0].oauthAccount.accountUuid] as $ids
        | all($users[]; type == "string" and length > 0) as $user_known
        | all($ids[]; type == "string" and length > 0) as $id_known
        | (($user_known and $c == $s) or ($id_known and $ids[0] == $ids[1]))
        and (if $user_known then $c == $s else true end)
        and (if $id_known then $ids[0] == $ids[1] else true end)
        and ([$current[0].oauthAccount.emailAddress, $saved[0].oauthAccount.emailAddress] as $emails
            | if all($emails[]; type == "string" and length > 0) then $emails[0] == $emails[1] else true end)
    ' >/dev/null 2>&1; then printf '%s\n' "$active"; fi
}

# Keychain and the optional file can coexist. Clear only the login field in
# both stores; malformed optional files fail preflight before either is changed.
cleanup_credentials_file_is_valid() {
    jq -se 'length == 1 and (.[0] | type) == "object" and
        (.[0].claudeAiOauth == null or (.[0].claudeAiOauth | type) == "object")' "$STRAY_CREDENTIALS_FILE" >/dev/null
}

cleanup_optional_credentials_file() {
    local temporary status=0
    [ -f "$STRAY_CREDENTIALS_FILE" ] || return 0
    cleanup_credentials_file_is_valid || return 1
    jq -e 'has("claudeAiOauth")' "$STRAY_CREDENTIALS_FILE" >/dev/null || status=$?
    case "$status" in 0) ;; 1) return 0 ;; *) return 1 ;; esac
    temporary=$(mktemp "$CONFIG_DIR/.credentials.XXXXXXXX") || return 1
    if ! jq 'del(.claudeAiOauth)' "$STRAY_CREDENTIALS_FILE" > "$temporary" \
        || ! chmod 600 "$temporary" || ! mv "$temporary" "$STRAY_CREDENTIALS_FILE"; then
        rm -f "$temporary"
        return 1
    fi
}

cleanup_is_complete() {
    local recovery
    if [ -e "$CLEANUP_RECOVERY_DIR" ] || [ -L "$CLEANUP_RECOVERY_DIR" ]; then
        echo "Error: Previous cleanup incomplete; recovery data retained at $CLEANUP_RECOVERY_DIR" >&2
        echo "Restore the paths in manifest.json and config/metadata copies before removing that directory; credentials may require a saved profile or login." >&2
        return 1
    fi
    if recovery=$(profile_recovery_path); then
        echo "Error: Previous profile operation incomplete; recovery data retained at $recovery" >&2
        echo "Restore the paths in manifest.json before removing that directory and retrying." >&2
        return 1
    fi
    return 0
}

clean_unnamed_session() {
    local credentials path entry session_entry
    [ ! -e "$ACTIVE_FILE" ] && [ ! -L "$ACTIVE_FILE" ] || return 1
    credentials=$(read_credentials) && credentials=$(claude_login_only "$credentials") || return 1
    [ "$credentials" = '{}' ] || return 1
    if [ -f "$STRAY_CREDENTIALS_FILE" ]; then
        cleanup_credentials_file_is_valid && ! jq -e '.claudeAiOauth != null' "$STRAY_CREDENTIALS_FILE" >/dev/null || return 1
    fi
    jq -e '.oauthAccount == null' "$CLAUDE_JSON" >/dev/null || return 1
    for entry in "${ACCOUNT_PATHS[@]}"; do
        path=${entry#*|}
        # A logged-out CLI may leave only an empty registry directory. This
        # contains no session to preserve; hidden entries and links still count.
        if [ "$path" = "$CONFIG_DIR/sessions" ] && [ -d "$path" ] && [ ! -L "$path" ]; then
            [ -r "$path" ] && [ -x "$path" ] || return 1
            for session_entry in "$path"/* "$path"/.[!.]* "$path"/..?*; do
                [ ! -e "$session_entry" ] && [ ! -L "$session_entry" ] || return 1
            done
            continue
        fi
        [ ! -e "$path" ] && [ ! -L "$path" ] || return 1
    done
}

# Check deterministic filesystem failures before moving history or touching
# credentials. A missing parent can be created only under a writable ancestor.
cleanup_parent_is_writable() {
    local parent
    parent=$(dirname "$1")
    while [ ! -e "$parent" ]; do parent=$(dirname "$parent"); done
    [ -d "$parent" ] && [ -w "$parent" ] && [ -x "$parent" ]
}

cleanup_file_is_writable() {
    cleanup_parent_is_writable "$1" && { [ ! -e "$1" ] || [ -w "$1" ]; }
}

# These helpers use new_command's local transaction arrays and in-memory
# credential snapshots. No Keychain secret is ever written to recovery files.
cleanup_stage_and_reset() {
    local index path entry label
    for ((index=0; index<${#cleanup_paths[@]}; index++)); do
        path=${cleanup_paths[index]}
        if [ -e "$path" ]; then
            if ! mv "$path" "$CLEANUP_RECOVERY_DIR/data/$index"; then
                # A cross-filesystem move can leave a destination even on
                # failure. Keep it for rollback/inspection rather than purge it.
                if [ -e "$CLEANUP_RECOVERY_DIR/data/$index" ]; then
                    staged_locations[index]="$CLEANUP_RECOVERY_DIR/data/$index"
                fi
                return 1
            fi
            staged_locations[index]="$CLEANUP_RECOVERY_DIR/data/$index"
        fi
    done
    credentials_attempted=yes
    replace_credentials '' && cleanup_optional_credentials_file || return 1
    config_attempted=yes
    if [ ! -f "$CLAUDE_JSON" ]; then (umask 077; printf '{}\n' > "$CLAUDE_JSON") || return 1; fi
    reset_account_state || return 1
    if [ -n "$active" ]; then
        mkdir -p -m 700 "$ACCOUNTS_DIR/$active" || return 1
        for ((index=0; index<${#ACCOUNT_PATHS[@]}; index++)); do
            if [ -n "${staged_locations[index]}" ]; then
                entry=${ACCOUNT_PATHS[index]}; label=${entry%%|*}
                mv "${staged_locations[index]}" "$ACCOUNTS_DIR/$active/$label" || return 1
                staged_locations[index]="$ACCOUNTS_DIR/$active/$label"
            fi
        done
    fi
    metadata_attempted=yes
    rm -f "$LEGACY_PENDING_TIMEZONE_FILE" && rm -f "$ACTIVE_FILE" && rm -f "$LAUNCH_MODE_FILE" \
        && rm -f "$UNNAMED_SESSION_FILE" || return 1
    if [ -n "$selected_zone" ]; then
        mv "$CLEANUP_RECOVERY_DIR/selected-session" "$UNNAMED_SESSION_FILE" || return 1
    fi
    return 0
}

cleanup_restore_snapshot() {
    if [ -f "$CLEANUP_RECOVERY_DIR/$1" ]; then
        cp -p "$CLEANUP_RECOVERY_DIR/$1" "$2"
    else
        rm -f "$2"
    fi
}

cleanup_rollback() {
    local index path failed='' restored
    for ((index=${#cleanup_paths[@]}-1; index>=0; index--)); do
        [ -n "${staged_locations[index]}" ] || continue
        path=${cleanup_paths[index]}
        # Never overwrite anything that appeared while cleanup was running.
        if [ -e "$path" ] || [ -L "$path" ] \
            || ! mv "${staged_locations[index]}" "$path"; then failed=yes; fi
    done
    if [ -n "$credentials_attempted" ]; then
        if [ -n "$credentials" ]; then write_credentials "$credentials" || failed=yes
        else delete_credentials || failed=yes; fi
        if [ "$optional_existed" = yes ]; then
            (umask 077; printf '%s' "$optional_credentials" > "$STRAY_CREDENTIALS_FILE") || failed=yes
        else rm -f "$STRAY_CREDENTIALS_FILE" || failed=yes; fi
        restored=$(read_credentials) && [ "$restored" = "$credentials" ] || failed=yes
    fi
    if [ -n "$config_attempted" ]; then cleanup_restore_snapshot config.json "$CLAUDE_JSON" || failed=yes; fi
    if [ -n "$metadata_attempted" ]; then
        cleanup_restore_snapshot active "$ACTIVE_FILE" || failed=yes
        cleanup_restore_snapshot pending-timezone "$LEGACY_PENDING_TIMEZONE_FILE" || failed=yes
        cleanup_restore_snapshot unnamed-session "$UNNAMED_SESSION_FILE" || failed=yes
        cleanup_restore_snapshot launch-mode "$LAUNCH_MODE_FILE" || failed=yes
    fi
    if [ -z "$failed" ] && rm -rf -- "$CLEANUP_RECOVERY_DIR"; then
        echo "Error: Account cleanup failed; previous account, credentials and history restored" >&2
    else
        echo "Error: Account cleanup incomplete; rollback incomplete, recovery data retained at $CLEANUP_RECOVERY_DIR" >&2
        echo "No Keychain secrets were stored on disk; restore manifest.json paths and config/metadata copies, then use a saved profile or login if credentials could not be restored." >&2
    fi
}

# How new treats the current login before cleaning it:
#   save:<name>  logged in as the active profile's identity; refresh that backup first
#   clean        logged out and no active profile; nothing to lose
#   logout:<name> logged out while a profile is active; ask, never save over its backup
#   ask:<name>   the active profile does not match the current login
#   ask:         a login that no profile owns
# Reads only ~/.claude.json while logged in; credentials only to prove a logout.
new_cleanup_plan() {
    local active matching credentials
    active=$(active_account)
    matching=$(cleanup_matching_active)
    if [ -f "$CLAUDE_JSON" ] && ! jq -e '.oauthAccount == null' "$CLAUDE_JSON" >/dev/null 2>&1; then
        if [ -n "$active" ] && [ "$matching" = "$active" ]; then echo "save:$active"; else echo "ask:$active"; fi
        return 0
    fi
    # No account in the config: a login left in either credential store still counts.
    if ! credentials=$(read_credentials) || ! credentials=$(claude_login_only "$credentials") \
        || [ "$credentials" != '{}' ] \
        || { [ -f "$STRAY_CREDENTIALS_FILE" ] && ! jq -e '.claudeAiOauth == null' "$STRAY_CREDENTIALS_FILE" >/dev/null 2>&1; }; then
        echo "ask:$active"
    elif [ -z "$active" ]; then
        echo clean
    else
        echo "logout:$active"
    fi
}

# Full current-account cleanup. The active profile's own login is backed up
# first; a logout with no active profile is cleaned directly; anything else
# needs confirmation.
new_command() {
    local active confirmation credentials entry path label selected_zone plan save_name=''
    local optional_credentials='' optional_existed='' credentials_attempted='' config_attempted='' metadata_attempted=''
    local index destination
    local -a cleanup_paths staged_locations
    load_shell_companion || return 1
    cleanup_is_complete || return 1
    [ "$#" -eq 0 ] || { echo "Error: new accepts no arguments; choose timezone in its menu" >&2; return 1; }
    validate_unnamed_session || return 1
    # Validate the entire bounded cleanup set, including optional credentials,
    # before asking, reading the login, stopping processes or modifying anything.
    for path in "$CLAUDE_JSON" "$STRAY_CREDENTIALS_FILE" "$ACTIVE_FILE" "$LEGACY_PENDING_TIMEZONE_FILE" "$LAUNCH_MODE_FILE" "$UNNAMED_SESSION_FILE"; do
        _ccacc_shell_path "$path" file || { echo "Error: Unsafe cleanup path; cleanup incomplete: $path" >&2; return 1; }
    done
    if [ -f "$CLAUDE_JSON" ]; then
        jq -se 'length == 1 and (.[0] | type) == "object"' "$CLAUDE_JSON" >/dev/null || return 1
    fi
    if [ -f "$STRAY_CREDENTIALS_FILE" ]; then
        cleanup_credentials_file_is_valid || {
            echo "Error: Malformed optional credentials file; cleanup incomplete, credentials unchanged" >&2; return 1;
        }
    fi
    plan=$(new_cleanup_plan) || return 1
    case "$plan" in
        save:*)
            save_name=${plan#save:}
            echo "The current login belongs to active profile '$save_name'; it will be saved before cleanup." >&2 ;;
        clean)
            echo "Not logged in; cleaning without a backup." >&2 ;;
        *)
            if [ "${plan%%:*}" = logout ]; then
                echo "Not logged in, but profile '${plan#logout:}' is active; its saved login will not be updated." >&2
            elif [ -n "${plan#ask:}" ]; then
                echo "The current login does not match active profile '${plan#ask:}'; that profile will not be updated." >&2
            fi
            printf "Have you already run '$SCRIPT_NAME save <name>' to back up this account? (y/N): " >&2
            if ! IFS= read -r confirmation; then confirmation=''; fi
            case "$confirmation" in y|Y|yes) ;; *) echo "Cleanup cancelled; run '$SCRIPT_NAME save <name>' first." >&2; return 1 ;; esac ;;
    esac
    selected_zone=$(choose_timezone 'unnamed session' optional) || return 1
    if [ -f "$STRAY_CREDENTIALS_FILE" ]; then
        optional_existed=yes
        optional_credentials=$(cat "$STRAY_CREDENTIALS_FILE" && printf '.') || return 1
        optional_credentials=${optional_credentials%.}
    fi
    credentials=$(read_credentials) && claude_login_only "$credentials" >/dev/null || {
        echo "Error: Cannot read valid credentials; cleanup incomplete" >&2; return 1;
    }
    for entry in "${ACCOUNT_PATHS[@]}"; do cleanup_paths+=("${entry#*|}"); done
    # ide/ holds live IDE discovery locks, not account data; it is never cleared here.
    for entry in daemon jobs remote-settings.json policy-limits.json policy-limits.json.stamp.json plugins/plugin-directory-cache-v2.json plugins/plugin-catalog-cache.json; do
        cleanup_paths+=("$CONFIG_DIR/$entry")
    done
    _ccacc_shell_path "$HOME/.claude_backups" dir || {
        echo "Error: Unsafe recovery backup directory; cleanup incomplete" >&2; return 1;
    }
    # Only the cleaner's recognized timestamped recovery copies contain account
    # residue. Unrecognized backup names and all named ccacc profiles stay intact.
    for path in "$HOME/.claude_backups"/claude_*; do
        label=${path##*/}
        if [[ "$label" =~ ^claude_(\.claude\.json|claude\.json|dir)_[0-9]{8}_[0-9]{6}$ ]]; then
            cleanup_paths+=("$path")
        fi
    done
    for path in "${cleanup_paths[@]}"; do
        cleanup_path_is_safe "$path" || { echo "Error: Unsafe cleanup path; cleanup incomplete: $path" >&2; return 1; }
    done
    active=$(cleanup_matching_active)
    if [ -n "$active" ]; then
        cleanup_path_is_safe "$ACCOUNTS_DIR/$active" || return 1
        for entry in "${ACCOUNT_PATHS[@]}"; do
            label=${entry%%|*}; path=${entry#*|}
            cleanup_path_is_safe "$ACCOUNTS_DIR/$active/$label" || return 1
            if [ -e "$path" ] && [ -e "$ACCOUNTS_DIR/$active/$label" ]; then
                echo "Error: Saved history already exists; cleanup incomplete, resolve the stash conflict first" >&2
                return 1
            fi
        done
    fi
    # No probe writes: permission and ancestor checks are read-only. Check all
    # metadata/config/stash destinations before any irreversible work begins.
    _ccacc_shell_path "$CLEANUP_RECOVERY_DIR" dir || return 1
    for path in "$CLAUDE_JSON" "$STRAY_CREDENTIALS_FILE" "$ACTIVE_FILE" "$LEGACY_PENDING_TIMEZONE_FILE" "$LAUNCH_MODE_FILE" "$UNNAMED_SESSION_FILE"; do
        cleanup_file_is_writable "$path" || { echo "Error: Cleanup destination is not writable: $path" >&2; return 1; }
    done
    cleanup_parent_is_writable "$CLEANUP_RECOVERY_DIR/data" || return 1
    for path in "${cleanup_paths[@]}"; do
        if [ -e "$path" ]; then
            cleanup_parent_is_writable "$path" || { echo "Error: History parent is not writable: $path" >&2; return 1; }
        fi
    done
    if [ -n "$active" ]; then
        for entry in "${ACCOUNT_PATHS[@]}"; do
            cleanup_parent_is_writable "$ACCOUNTS_DIR/$active/${entry%%|*}" || {
                echo "Error: Saved history parent is not writable" >&2; return 1;
            }
        done
    fi
    # Interactive and before any process stop, as in use: a plain backup must not
    # sit next to a differing encrypted one.
    # Every check above is read-only: ask before closing Claude, the first change.
    confirm_close_claude new || return 1
    if [ -n "$save_name" ]; then migrate_encrypted_backups || return 1; fi
    cleanup_stop_processes && cleanup_runtime_is_safe || {
        echo "Error: Live or unverifiable processes/runtime owners; cleanup incomplete" >&2; return 1;
    }
    # Save only once Claude is stopped, and only if the login still is that profile's.
    if [ -n "$save_name" ]; then
        if [ "$active" != "$save_name" ] || [ "$(cleanup_matching_active)" != "$save_name" ]; then
            echo "Error: Current login changed while preparing cleanup; nothing cleaned, run '$SCRIPT_NAME new' again" >&2
            return 1
        fi
        save_account "$save_name" || { echo "Error: Could not save profile '$save_name'; nothing cleaned" >&2; return 1; }
        echo "Saved current login to profile '$save_name'." >&2
    fi
    mkdir -p -m 700 "$CONFIG_DIR" || return 1
    mkdir -p -m 700 "$ACCOUNTS_DIR" || return 1
    # One bounded recovery directory also invalidates the active fastpath if the
    # process exits or rollback fails. Its manifest contains paths, never secrets.
    mkdir -m 700 "$CLEANUP_RECOVERY_DIR" || return 1
    if ! mkdir -m 700 "$CLEANUP_RECOVERY_DIR/data"; then return 1; fi
    for entry in "config.json|$CLAUDE_JSON" "active|$ACTIVE_FILE" "pending-timezone|$LEGACY_PENDING_TIMEZONE_FILE" "launch-mode|$LAUNCH_MODE_FILE" "unnamed-session|$UNNAMED_SESSION_FILE"; do
        label=${entry%%|*}; path=${entry#*|}
        if [ -f "$path" ] && ! cp -p "$path" "$CLEANUP_RECOVERY_DIR/$label"; then
            rm -rf -- "$CLEANUP_RECOVERY_DIR"
            return 1
        fi
    done
    if ! (
        set -o pipefail
        umask 077
        for ((index=0; index<${#cleanup_paths[@]}; index++)); do
            [ -e "${cleanup_paths[index]}" ] || continue
            destination=''
            if [ -n "$active" ] && [ "$index" -lt "${#ACCOUNT_PATHS[@]}" ]; then
                entry=${ACCOUNT_PATHS[index]}; destination="$ACCOUNTS_DIR/$active/${entry%%|*}"
            fi
            jq -cn --arg source "${cleanup_paths[index]}" --arg staged "$CLEANUP_RECOVERY_DIR/data/$index" \
                --arg saved "$destination" '{source:$source, staged:$staged, saved:$saved}' || exit 1
        done | jq -s . > "$CLEANUP_RECOVERY_DIR/manifest.json"
    ); then rm -rf -- "$CLEANUP_RECOVERY_DIR"; return 1; fi
    if [ -n "$selected_zone" ]; then
        if ! (umask 077; jq -cn --arg zone "$selected_zone" '{version:1,timezone:$zone}' \
            > "$CLEANUP_RECOVERY_DIR/selected-session" && chmod 600 "$CLEANUP_RECOVERY_DIR/selected-session"); then
            rm -rf -- "$CLEANUP_RECOVERY_DIR"
            return 1
        fi
    fi
    if ! cleanup_stage_and_reset; then
        cleanup_rollback
        return 1
    fi
    rm -rf -- "$CLEANUP_RECOVERY_DIR" || {
        echo "Error: Session cleaned, but recovery removal incomplete: $CLEANUP_RECOVERY_DIR" >&2; return 1;
    }
    echo "Cleaned current account; started unnamed Claude session (logged out)."
    echo "Run 'claude /login', then '$SCRIPT_NAME save <name>' to name and save it."
}

# Run ccusage over the live ~/.claude and every saved profile's archived history,
# so usage of all accounts is counted. Read-only: nothing is moved or written.
usage_command() {
    local dirs="$CONFIG_DIR" dir name
    if ! command -v ccusage >/dev/null 2>&1; then
        echo "Error: ccusage is not installed; install it (for example 'npm install -g ccusage'), then retry" >&2
        return 1
    fi
    for dir in "$ACCOUNTS_DIR"/*/; do
        dir=${dir%/}; name=${dir##*/}
        check_name "$name" >/dev/null 2>&1 || continue
        if [ -d "$dir/projects" ] && [ ! -L "$dir" ] && [ ! -L "$dir/projects" ]; then
            dirs="$dirs,$dir"
        fi
    done
    # ccusage splits CLAUDE_CONFIG_DIR on commas.
    case "$CONFIG_DIR" in *,*) echo "Error: $CONFIG_DIR contains a comma; ccusage cannot read it" >&2; return 1 ;; esac
    CLAUDE_CONFIG_DIR="$dirs" ccusage "$@"
}

# Function to (re)pick a saved account's Surge policies; applies them when it is the active account
surge_command() {
    local name="${1:-}"
    check_name "$name" || return 1
    if [ ! -f "$ACCOUNTS_DIR/${name}.json" ]; then
        echo -e "${RED}Error: Account '${name}' not found${NC}" >&2
        return 1
    fi
    if ! find_surge; then
        echo -e "${RED}Error: Surge is not installed${NC}" >&2
        return 1
    fi
    if ! surge_groups >/dev/null; then
        echo -e "${RED}Error: Surge is not running; start it and run '$SCRIPT_NAME surge ${name}' again${NC}" >&2
        return 1
    fi
    setup_surge "$name" || return 1
    if [ "$(active_account)" = "$name" ]; then
        apply_surge "$name" || return 1
    fi
}

# Function to delete a saved account
delete_command() (
    local name="${1:-}" reply='' active
    local _ccacc_profile_tx_dir='' _ccacc_profile_tx_committed='' _ccacc_profile_tx_writes=''
    local -a _ccacc_profile_tx_entries
    umask 077
    check_name "$name" || return 1
    check_ready || return 1
    load_shell_companion || return 1
    cleanup_is_complete || return 1
    if [ ! -f "$ACCOUNTS_DIR/${name}.json" ]; then
        echo -e "${RED}Error: Account '${name}' not found${NC}"
        return 1
    fi
    # Inspect only a safe regular session record. Do not alter the runtime mode
    # of another retained profile, even when that record is read-only.
    _ccacc_shell_path "$LAUNCH_MODE_FILE" file && \
        { [ ! -f "$LAUNCH_MODE_FILE" ] || [ -r "$LAUNCH_MODE_FILE" ]; } || {
        echo "Error: Cannot safely inspect current launch mode; account unchanged" >&2; return 1;
    }
    if [ -f "$LAUNCH_MODE_FILE" ] && jq -se --arg account "$name" 'length == 1 and (.[0] |
        keys == ["account", "version", "yolo"] and .version == 1 and .account == $account and
        (.yolo | type == "boolean"))' "$LAUNCH_MODE_FILE" >/dev/null 2>&1; then
        _ccacc_profile_tx_entries=("file|$LAUNCH_MODE_FILE")
    fi
    active=$(active_account)
    if [ "$active" = "$name" ]; then
        echo -e "${YELLOW}Warning: '${name}' is currently active; its login and history stay in place but are no longer saved${NC}"
        _ccacc_profile_tx_entries+=("file|$ACTIVE_FILE")
    else
        echo -e "${YELLOW}Warning: this deletes the saved login and history of '${name}'${NC}"
    fi
    if ! IFS= read -r -n 1 -p "Delete anyway? (y/N): " reply; then reply=''; fi
    echo
    case "$reply" in y|Y) ;; *) return 1 ;; esac
    _ccacc_profile_tx_entries+=("file|$ACCOUNTS_DIR/$name.json" "file|$ACCOUNTS_DIR/$name.credentials"
        "file|$ACCOUNTS_DIR/$name.credentials.enc" "file|$ACCOUNTS_DIR/$name.surge" "file|$ALIASES_DIR/$name.json" "file|$TIMEZONES_DIR/$name"
        "dir|$ACCOUNTS_DIR/$name")
    _ccacc_profile_tx_preflight || return 1
    trap '_ccacc_profile_tx_finish' EXIT
    trap 'exit 130' INT
    _ccacc_profile_tx_stage || return 1
    _ccacc_profile_tx_committed=yes
    echo -e "${GREEN}Deleted account: ${name}${NC}"
)

# ccacc relies on the macOS keychain (/usr/bin/security); refuse anything else.
require_macos() {
    local platform
    platform=$(uname -s 2>/dev/null) || platform=''
    if [ "$platform" != Darwin ]; then
        echo "Error: ccacc supports macOS only (uname -s reported '${platform:-unknown}')" >&2
        return 1
    fi
}

# Main function
main() {
    case "${1:-}" in
        help|--help|-h|--version|-v|"") ;;
        *) require_macos || exit 1 ;;
    esac
    case "${1:-}" in
        list|ls)
            list_accounts
            ;;
        current)
            show_current
            ;;
        save)
            shift
            save_command "$@"
            ;;
        timezone)
            [ "$#" -le 3 ] || return 1
            if [ "$#" -eq 3 ]; then
                echo "Error: timezone is read-only; switch with '$SCRIPT_NAME use $2', then run '$SCRIPT_NAME save $2 --timezone <ZONE>'" >&2
                return 1
            else
                timezone_command "${2:-}"
            fi
            ;;
        install)
            echo "Error: Install/reinstall ccacc with: $INSTALL_COMMAND" >&2
            return 1
            ;;
        configure-shell)
            [ "$#" -le 2 ] || { echo "Error: configure-shell accepts at most one account" >&2; return 1; }
            configure_shell_command
            ;;
        launch-mode)
            [ "$#" = 1 ] || return 1
            launch_mode_command
            ;;
        use)
            shift
            use_command "$@"
            ;;
        new)
            shift
            new_command "$@"
            ;;
        surge)
            surge_command "$2"
            ;;
        usage)
            shift
            usage_command "$@"
            ;;
        rm)
            delete_command "$2"
            ;;
        help|--help|-h)
            usage
            ;;
        --version|-v)
            version
            ;;
        "")
            usage
            ;;
        *)
            echo -e "${RED}Error: Unknown command '${1}'${NC}"
            usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
